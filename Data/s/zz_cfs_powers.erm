!?FU(CSP_Reset);
!!SN:W^cfs.power.v1.active^/0 W^cfs.power.v1.ready^/0 W^cfs.power.v1.executing^/0 W^cfs.power.v1.poison.pending^/0;
!!re (side:y)/0/1;
 !!re (set:y)/0/7;
  !!SN:W^cfs.power.v1.used.%(side).%(set)^/0 W^cfs.power.v1.until.%(side).%(set)^/0;
 !!en;
!!en;

!?FU(OnBeforeBattleUniversal);
!!FU(CSP_Reset):P;
!?FU(OnBattleReplay);
!!FU(CSP_Reset):P;
!?BA1;
!!SN:W^cfs.power.v1.active^/0 W^cfs.power.v1.executing^/0 W^cfs.power.v1.poison.pending^/0;

!?BF;
!!BA:A?(simulation:y) Q?(quick:y);
!!FU|(simulation)>0/(quick)>0:E;
!!SN:W^cfs.power.v1.ready^/?(ready:y);
!!FU&(ready)>0:E;
!!SN:W^cfs.power.v1.active^/1 W^cfs.power.v1.ready^/1;

!?FU(CSP_Context);
!#VA(hero:x) (side:x) (set:x) (okay:x);
!!VR(okay):S0;
!!FU|(hero)<0/(side)<0/(side)>1/(set)<0/(set)>7:E;
!!SN:W^cfs.power.v1.active^/?(active:y) W^cfs.power.v1.executing^/?(executing:y);
!!FU|(active)=0/(executing)>0:E;
!!BA:A?(simulation:y) Q?(quick:y);
!!FU|(simulation)>0/(quick)>0:E;
!!BU:T?(tactics:y);
!!FU&(tactics)>0:E;
!!BA:H(side)/?(actual:y);
!!FU&(actual)<>(hero):E;
!!FU&i^battle_current_side^<>(side):E;
!!FU&i^battle_round^<0:E;
!!FU(GetMaxHeroId):P?(last:y);
!!FU&(hero)>(last):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!FU(CFS_Info):P(set)/?i/?(relic:y)/?i/?i/?i/?i/?i/?i;
!!HE(hero):A2/(relic)/?i/?(worn:y);
!!FU&(worn)<=0:E;
!!SN:W^cfs.power.v1.used.%(side).%(set)^/?(used:y);
!!FU&(used)>0:E;
!!FU(CSP_Info):P(set)/?i/?(cost:y);
!!HE(hero):I?(mana:y);
!!FU&(mana)<(cost):E;
!!VR(okay):S1;

!?FU(CSP_Math);
!#VA(kind:x) (power:x) (coefficient:x) (bonus:x) (budget:x);
!!VR(power)&(power)<0:S0;
!!VR(power)&(power)>10000:S10000;
!!VR(coefficient)&(coefficient)<0:S0;
!!VR(coefficient)&(coefficient)>10000:S10000;
!!VR(bonus)&(bonus)<0:S0;
!!VR(bonus)&(bonus)>100000:S100000;
!!VR(budget):S0;
!!VR(budget)&(kind)=0:S(power) *(coefficient) +(bonus);
!!VR(budget)&(kind)=1:S(power) *5 +20;
!!VR(budget)&(kind)=2:S(power) *25 +100;
!!VR(budget)&(kind)=3:S(power) *25 +50;
!!VR(budget)&(budget)>100000:S100000;

!?FU(CSP_Share);
!#VA(budget:x) (remaining:x) (missing:x) (share:x);
!!VR(share):S0;
!!FU|(budget)<=0/(remaining)<=0/(missing)<=0:E;
!!VR(budget)&(budget)>100000:S100000;
!!VR(share):S(budget) +(remaining) -1 :(remaining);
!!VR(share)&(share)>(missing):S(missing);

!?FU(CSP_RagePercent);
!#VA(attack:x) (percent:x);
!!VR(attack)&(attack)<0:S0;
!!VR(attack)&(attack)>80:S80;
!!VR(percent):S(attack) :2 +10;

!?FU(CSP_RageDamage);
!#VA(damage:x) (percent:x) (result:x);
!!VR(result):S(damage);
!!FU&(damage)<=0:E;
!!VR(percent)&(percent)<0:S0;
!!VR(percent)&(percent)>50:S50;
; Split the multiplication so a valid native signed-int damage cannot overflow.
!!VR(whole:y):S(damage) :100 *(percent);
!!VR(fraction:y):S(damage) %100 *(percent) :100;
!!VR(extra:y):S(whole) +(fraction);
!!VR(room:y):S2147483647 -(damage);
!!VR(extra)&(extra)>(room):S(room);
!!VR(result):+(extra);

!?FU(CSP_StackHp);
!#VA(stack:x) (hp:x);
!!VR(hp):S0;
!!FU|(stack)<0/(stack)>41:E;
!!BM(stack):T?(type:y) N?(count:y);
!!FU|(type)<0/(type)>196/(count)<=0:E;
!!BM(stack):H?(unit:y) L?(lost:y);
!!VR(count)&(count)>100000:S100000;
!!VR(unit)&(unit)<1:S1;
!!VR(unit)&(unit)>20000:S20000;
!!VR(hp):S(count) *(unit) -(lost);
!!VR(hp)&(hp)<0:S0;

!?FU(CSP_Own);
!#VA(stack:x) (side:x) (set:x) (restore:x) (okay:x) (missing:x);
!!VR(okay):S0;
!!VR(missing):S0;
!!FU|(stack)<0/(stack)>41:E;
!!BM(stack):T?(type:y) N?(count:y) I?(actual:y);
!!FU|(type)<0/(type)>196/(actual)<>(side):E;
!!FU(CFS_Member):P(set)/(type)/?(member:y)/?i;
!!FU&(member)=0:E;
!!BM(stack):F?(flags:y);
!!VR(excluded:y):S(flags) &12582976;
!!FU&(excluded)>0:E;
!!if&(restore)=0;
 !!VR(okay)&(count)>0:S1;
 !!FU:E;
!!en;
!!BM(stack):O?(armySlot:y) B?(initial:y) H?(unit:y) P?(hex:y);
!!FU|(armySlot)<0/(armySlot)>6/(initial)<=0/(initial)>100000/(unit)<1/(unit)>20000/(hex)<0/(hex)>186:E;
!!VR(living:y):S(flags) &16;
!!VR(undead:y):S(flags) &262144;
!!FU&(set)=0/(living)=0:E;
!!FU&(set)=3/(undead)=0:E;
!!if&(count)<=0;
 !!BU:E(hex)/?(occupant:y);
 !!FU&(occupant)>=0:E;
!!en;
!!FU(CSP_StackHp):P(stack)/?(current:y);
!!VR(missing):S(initial) *(unit) -(current);
!!VR(okay)&(missing)>0:S1;

!?FU(CSP_Enemy);
!#VA(stack:x) (side:x) (drain:x) (okay:x);
!!VR(okay):S0;
!!FU|(stack)<0/(stack)>41:E;
!!BM(stack):T?(type:y) N?(count:y) I?(actual:y);
!!FU|(type)<0/(type)>196/(count)<=0/(actual)=(side):E;
!!BM(stack):F?(flags:y);
!!VR(siege:y):S(flags) &64;
!!FU&(siege)>0:E;
!!if&(drain)>0;
 !!VR(living:y):S(flags) &16;
 !!VR(excluded:y):S(flags) &12582912;
 !!FU|(living)=0/(excluded)>0:E;
!!en;
!!VR(okay):S1;

!?FU(CSP_GateSpace);
!#VA(side:x) (hex:x);
!!VR(hex):S-1;
!!VR(occupied:y):S0;
!!re (stack:y)/0/41;
 !!BM(stack):N?(count:y) I?(owner:y);
 !!VR(occupied)&(count)>0/(owner)=(side):+1;
!!en;
!!FU&(occupied)>=20:E;
!!VR(column:y):S2;
!!VR(column)&(side)=1:S14;
!!re (row:y)/1/9;
 !!VR(at:y):S(row) *17 +(column);
 !!BU:E(at)/?(unit:y) O(at)/?(obstacle:y) D(at)/?(corpse:y);
 !!if&(unit)<0/(obstacle)=0/(corpse)<0;
  !!VR(hex):S(at);
  !!FU:E;
 !!en;
!!en;

!?FU(CSP_Preflight);
!#VA(side:x) (set:x) (choice:x) (target:x) (okay:x) (caster:x);
!!VR(okay):S0;
!!VR(caster):S-1;
!!FU|(set)<0/(set)>7/(side)<0/(side)>1/(choice)<0/(choice)>3:E;
!!FU&(set)<>7/(choice)<>0:E;
!!re (stack:y)/0/41;
 !!BM(stack):T?(type:y) N?(count:y) I?(owner:y);
 !!if&(type)>=0/(type)<=196/(count)>0/(owner)=(side)/(caster)<0;
  !!VR(caster):S(stack);
 !!en;
!!en;
!!FU&(caster)<0:E;
!!if|(set)=4/(set)=7;
 !!if|(set)=4/(choice)=0;
  !!FU(CSP_Enemy):P(target)/(side)/0/?(okay);
  !!FU:E;
 !!en;
!!en;
!!if&(set)=2;
 !!FU(CSP_GateSpace):P(side)/?(hex:y);
 !!VR(okay)&(hex)>=0:S1;
 !!FU:E;
!!en;
!!re (unit:y)/0/41;
 !!if&(set)=3;
  !!FU(CSP_Enemy):P(unit)/(side)/1/?(eligible:y);
 !!el;
  !!VR(restore:y):S0;
  !!VR(restore)&(set)=0:S1;
  !!FU(CSP_Own):P(unit)/(side)/(set)/(restore)/?(eligible)/?i;
 !!en;
 !!VR(okay)&(eligible)>0:S1;
!!en;

; Native fixed-HP cast. Restore the entire modified spell entry immediately.
!?FU(CSP_FixedSpell);
!#VA(caster:x) (target:x) (spell:x) (hp:x) (restore:x);
!!FU&(hp)<=0:E;
!!BM(caster):N?(living:y);
!!FU&(living)<=0:E;
!!BM(target):P?(hex:y);
!!FU|(hex)<0/(hex)>186:E;
!!SS(spell):P?(coefficient:y) E0/?(e0:y) E1/?(e1:y) E2/?(e2:y) E3/?(e3:y);
!!SS(spell):P0 E0/(hp) E1/(hp) E2/(hp) E3/(hp);
!!VR(check:y):S1 -(restore);
!!BM(caster):C(spell)/(hex)/3/0/(check);
!!SS(spell):P(coefficient) E0/(e0) E1/(e1) E2/(e2) E3/(e3);

!?FU(CSP_Restore);
!#VA(side:x) (set:x) (caster:x) (budget:x);
!!VR(remaining:y):S0;
!!re (stack:y)/0/41;
 !!FU(CSP_Own):P(stack)/(side)/(set)/1/?(eligible:y)/?i;
 !!VR(remaining)&(eligible)>0:+1;
!!en;
!!VR(spell:y):S38;
!!VR(spell)&(set)=3:S39;
!!re (unit:y)/0/41;
 !!FU(CSP_Own):P(unit)/(side)/(set)/1/?(valid:y)/?(missing:y);
 !!co&(valid)=0;
 !!FU(CSP_Share):P(budget)/(remaining)/(missing)/?(share:y);
 !!VR(remaining):-1;
 !!VR(budget):-(share);
 !!FU(CSP_FixedSpell):P(caster)/(unit)/(spell)/(share)/1;
!!en;

!?FU(CSP_HealTop);
!#VA(side:x) (set:x) (amount:x);
!!re (stack:y)/0/41;
 !!FU(CSP_Own):P(stack)/(side)/(set)/0/?(eligible:y)/?i;
 !!co&(eligible)=0;
 !!BM(stack):L?(lost:y);
 !!VR(lost):-(amount);
 !!VR(lost)&(lost)<0:S0;
 !!BM(stack):L(lost);
!!en;

!?FU(CSP_Buff);
!#VA(side:x) (set:x) (spell:x);
!!re (stack:y)/0/41;
 !!FU(CSP_Own):P(stack)/(side)/(set)/0/?(eligible:y)/?i;
 !!co&(eligible)=0;
 !!BM(stack):M(spell)/2/3;
!!en;

!?FU(CSP_Effect);
!#VA(hero:x) (side:x) (set:x) (choice:x) (target:x) (caster:x);
!!HE(hero):F?i/?i/?(power:y)/?i;
!!VR(power)&(power)<0:S0;
!!VR(power)&(power)>10000:S10000;
