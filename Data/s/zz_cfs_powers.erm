ZVSE2
; First Strike uses the primary physical hit inside ACM's actual attack frame.
!?FU(OnBeforeBattleUniversal);
!!FU(CSP_FirstStrikeReset):P;
!?FU(OnBattleReplay);
!!FU(CSP_FirstStrikeReset):P;
!?BA1;
!!SN:W^cfs.power.v1.active^/0 W^cfs.strike.active^/0;

!?BF;
!!BA:A?(simulation:y) Q?(quick:y);
!!FU|(simulation)>0/(quick)>0:E;
!!SN:W^cfs.power.v1.active^/1;
; Shipped MF caller capture and both ordinary damage return sites.
!!UN:C7760425/0/(UNC_INT)/?(capture:y) C7760429/0/(UNC_INT)/?(pointer:y);
!!UN:C4455011/0/(UNC_INT)/?(shoot:y) C4462398/0/(UNC_INT)/?(melee:y);
!!FU|(capture)<>-1560001141/(pointer)<>42149568/(shoot)<>-955759223/(melee)<>-1946925687:E;
!!SN:W^cfs.strike.active^/1;

!?FU(CSP_FirstStrikeReset);
!!SN:W^cfs.power.v1.active^/0 W^cfs.power.v1.executing^/0 W^cfs.strike.active^/0;
!!re (stack:y)/0/41;
 !!SN:W^cfs.strike.used.%(stack)^/0;
!!en;

; Keep the retired network entry reserved. New damage is calculated on each peer.
!?FU26902;

!?MF1;
!!FU(CSP_FirstStrike):P;

!?FU(CSP_FirstStrike);
!!SN:W^cfs.strike.active^/?(active:y) W^cfs.leech.v1.depth^/?(depth:y);
!!FU|(active)=0/(depth)<1/(depth)>64:E;
!!BA:A?(simulation:y) Q?(quick:y);
!!FU|(simulation)>0/(quick)>0:E;
!!UN:C42149568/0/(UNC_INT)/?(caller:y);
!!BG:A?(action:y) N?(attacker:y) E?(primary:y);
!!FU&(action)<>(BATTLE_ACTION_WALK_AND_ATTACK)/(action)<>(BATTLE_ACTION_SHOOT):E;
!!FU&(action)=(BATTLE_ACTION_WALK_AND_ATTACK)/(caller)<>4462398:E;
!!FU&(action)=(BATTLE_ACTION_SHOOT)/(caller)<>4455011:E;
!!MF:W?(special:y) E?(allowed:y) F?(damage:y) N?(target:y);
!!FU|(special)<>0/(allowed)=0/(damage)<=0/(target)<>(primary):E;
!!FU|(attacker)<0/(attacker)>41/(target)<0/(target)>41:E;
!!SN:W^cfs.leech.v1.frame.%(depth).attacker^/?(actual:y) W^cfs.leech.v1.frame.%(depth).defender^/?(defender:y) W^cfs.strike.used.%(attacker)^/?(used:y);
!!FU|(actual)<>(attacker)/(defender)<>(target)/(used)>0:E;
!!BM(attacker):I?(originalSide:y) T?(type:y) F?(flags:y);
!!VR(temporary:y):S(flags) &12582912;
!!FU&(temporary)>0:E;
!!FU(ACM_GetActualStackSide):P(attacker)/?(side:y);
!!FU|(side)<0/(side)>1/(side)<>(originalSide):E;
!!FU(ACM_GetActualStackSide):P(target)/?(targetSide:y);
!!FU&(targetSide)=(side):E;
!!BA:H(side)/?(hero:y);
!!FU|(hero)<0/(hero)>155:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!FU(CSP_FirstStrikeEligible):P(hero)/(type)/?(eligible:y);
!!FU&(eligible)=0:E;
; Add floor(25%) without overflow. A valid first hit consumes the stack's use.
!!VR(bonus:y):S(damage) :4;
!!VR(room:y):S2147483647 -(damage);
!!VR(bonus)&(bonus)>(room):S(room);
!!VR(damage):+(bonus);
!!MF:F(damage);
!!SN:W^cfs.strike.used.%(attacker)^/1;

!?FU(CSP_FirstStrikeEligible);
!#VA(hero:x) (type:x) (eligible:x);
!!VR(eligible):S0;
!!FU(CFS_TowerMember):P(type)/?(member:y);
!!if&(member)=1;
 !!HE(hero):A2/458/?i/?(towerWorn:y);
 !!VR(eligible)&(towerWorn)>0:S1;
 !!FU&(eligible)>0:E;
!!en;
!!re (set:y)/0/7;
 !!FU(CFS_Info):P(set)/?i/?(relic:y)/?i/?i/?i/?i/?i/?i;
 !!HE(hero):A2/(relic)/?i/?(worn:y);
 !!co&(worn)<=0;
 !!FU(CFS_Member):P(set)/(type)/?(member)/?i;
 !!VR(eligible)&(member)=1:S1;
 !!FU&(eligible)>0:E;
!!en;

; Additional 30-percent physical life drain, assembled Necropolis relic only.
; Uses existing ACM physical-attack events; no creature-type/faction filter.
!?FU(OnBeforeBattleUniversal);
!!SN:W^cfs.leech.v1.depth^/0;
!?FU(OnBattleReplay);
!!SN:W^cfs.leech.v1.depth^/0;
!?BA1;
!!SN:W^cfs.leech.v1.depth^/0;

!?FU(ACM_OnBeforeAttack);
!#VA(attacker:x) (defender:x);
!!FU(CSP_LeechBegin):P(attacker)/(defender);
!?FU(ACM_OnAfterAttack);
!#VA(attacker:x) (defender:x) (mode:x);
!!FU(CSP_LeechEnd):P(attacker)/(defender);
!?MF1;
!!FU(CSP_LeechHit):P;

!?FU(CSP_LeechHp);
!#VA(stack:x) (health:x);
!!VR(health):S0;
!!FU|(stack)<0/(stack)>41:E;
!!BM(stack):N?(number:y) H?(unit:y) L?(lost:y);
!!FU|(number)<=0/(unit)<=0/(lost)<0/(lost)>=(unit):E;
!!VR(limit:y):S2147483647 :(unit);
!!FU&(number)>(limit):E;
!!VR(health):S(number) *(unit) -(lost);

!?FU(CSP_LeechAmount);
!#VA(damage:x) (health:x) (amount:x);
!!VR(amount):S0;
!!FU|(damage)<=0/(health)<=0:E;
!!VR(damage)&(damage)>(health):S(health);
; floor(damage * 30 / 100) without signed integer multiplication overflow.
!!VR(amount):S(damage) :10 *3;
!!VR(rest:y):S(damage) %10 *3 :10;
!!VR(amount):+(rest);

!?FU(CSP_LeechBegin);
!#VA(attacker:x) (defender:x);
!!SN:W^cfs.leech.v1.depth^/?(depth:y);
!!VR(depth):+1;
!!SN:W^cfs.leech.v1.depth^/(depth);
!!FU&(depth)>64:E;
!!SN:W^cfs.leech.v1.frame.%(depth).active^/0 W^cfs.leech.v1.frame.%(depth).heal^/0 W^cfs.leech.v1.frame.%(depth).attacker^/(attacker) W^cfs.leech.v1.frame.%(depth).defender^/(defender);
!!FU|(attacker)<0/(attacker)>41/(defender)<0/(defender)>41:E;
!!SN:W^cfs.power.v1.active^/?(active:y) W^cfs.power.v1.executing^/?(executing:y);
!!FU|(active)=0/(executing)>0:E;
!!BA:A?(simulation:y) Q?(quick:y);
!!FU|(simulation)>0/(quick)>0:E;
!!FU(ACM_GetActualStackSide):P(attacker)/?(side:y);
!!FU|(side)<0/(side)>1:E;
!!BA:H(side)/?(hero:y);
!!FU&(hero)<0:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!HE(hero):A2/494/?i/?(worn:y);
!!FU&(worn)<=0:E;
!!FU(CSP_LeechHp):P(attacker)/?(health:y);
!!FU&(health)<=0:E;
!!SN:W^cfs.leech.v1.frame.%(depth).active^/1 W^cfs.leech.v1.frame.%(depth).side^/(side) W^cfs.leech.v1.frame.%(depth).hero^/(hero);

!?FU(CSP_LeechHit);
!!SN:W^cfs.leech.v1.depth^/?(depth:y);
!!FU|(depth)<=0/(depth)>64:E;
!!SN:W^cfs.leech.v1.frame.%(depth).active^/?(active:y) W^cfs.leech.v1.frame.%(depth).side^/?(side:y);
!!FU&(active)=0:E;
!!SN:W^cfs.power.v1.executing^/?(executing:y);
!!FU&(executing)>0:E;
!!MF:W?(special:y) F?(damage:y) E?(allowed:y) N?(target:y);
!!FU|(special)<>0/(damage)<=0/(allowed)=0/(target)<0/(target)>41:E;
!!FU(ACM_GetActualStackSide):P(target)/?(targetSide:y);
!!FU&(targetSide)=(side):E;
!!BM(target):F?(flags:y);
!!VR(living:y):S(flags) &16;
!!VR(clone:y):S(flags) &8388608;
!!FU|(living)=0/(clone)>0:E;
!!FU(CSP_LeechHp):P(target)/?(health:y);
!!FU(CSP_LeechAmount):P(damage)/(health)/?(amount:y);
!!SN:W^cfs.leech.v1.frame.%(depth).heal^/?(total:y);
!!VR(room:y):S2147483647 -(total);
!!VR(amount)&(amount)>(room):S(room);
!!VR(total):+(amount);
!!SN:W^cfs.leech.v1.frame.%(depth).heal^/(total);

!?FU(CSP_LeechRestore);
!#VA(stack:x) (amount:x) (healed:x) (revived:x);
!!VR(healed):S0;
!!VR(revived):S0;
!!FU|(stack)<0/(stack)>41/(amount)<=0:E;
!!FU(CSP_LeechHp):P(stack)/?(health:y);
!!FU&(health)<=0:E;
!!BM(stack):N?(number:y) H?(unit:y) B?(initial:y);
!!VR(initial)&(initial)<=0:S(number);
!!VR(limit:y):S2147483647 :(unit);
!!FU|(initial)>(limit)/(initial)<(number):E;
!!VR(maximum:y):S(initial) *(unit);
!!VR(missing:y):S(maximum) -(health);
!!FU&(missing)<=0:E;
!!VR(healed):S(amount);
!!VR(healed)&(healed)>(missing):S(missing);
!!VR(newHealth:y):S(health) +(healed);
!!VR(newNumber:y):S(newHealth) -1 :(unit) +1;
!!VR(newLost:y):S(newNumber) *(unit) -(newHealth);
!!VR(revived):S(newNumber) -(number);
!!BM(stack):N(newNumber) L(newLost);

!?FU(CSP_LeechEnd);
!#VA(attacker:x) (defender:x);
!!SN:W^cfs.leech.v1.depth^/?(depth:y);
!!FU&(depth)<=0:E;
!!VR(next:y):S(depth) -1;
!!SN:W^cfs.leech.v1.depth^/(next);
!!FU&(depth)>64:E;
!!SN:W^cfs.leech.v1.frame.%(depth).active^/?(active:y) W^cfs.leech.v1.frame.%(depth).heal^/?(amount:y) W^cfs.leech.v1.frame.%(depth).attacker^/?(expected:y) W^cfs.leech.v1.frame.%(depth).defender^/?(expectedDefender:y) W^cfs.leech.v1.frame.%(depth).side^/?(side:y) W^cfs.leech.v1.frame.%(depth).hero^/?(hero:y);
!!SN:W^cfs.leech.v1.frame.%(depth).active^/0 W^cfs.leech.v1.frame.%(depth).heal^/0;
!!if|(attacker)<>(expected)/(defender)<>(expectedDefender);
 !!SN:W^cfs.leech.v1.depth^/0;
 !!FU:E;
!!en;
!!FU|(active)=0/(amount)<=0:E;
!!FU(ACM_GetActualStackSide):P(attacker)/?(currentSide:y);
!!FU&(currentSide)<>(side):E;
!!BA:H(side)/?(currentHero:y);
!!FU&(currentHero)<>(hero):E;
!!HE(hero):A2/494/?i/?(worn:y);
!!FU&(worn)<=0:E;
!!FU(CSP_LeechRestore):P(attacker)/(amount)/?(healed:y)/?(revived:y);
!!FU&(healed)<=0:E;
!!BU:R;
!!VR(log:z):S^Life Leech restores %(healed) Health.^;
!!VR(log)&(revived)=1:S^Life Leech restores %(healed) Health. One creature rises from the dead.^;
!!VR(log)&(revived)>1:S^Life Leech restores %(healed) Health. %(revived) creatures rise from the dead.^;
!!MM:S(log);
