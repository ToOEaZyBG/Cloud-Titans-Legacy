; Development extension. Generated definitions precede this body.
; No native hook is installed here: existing adapters call these functions.
!#SN:W^cfs.ai.block^/1;

; Clean pre-existing/directly written AI inventory only at safe event boundaries.
; New native grants are rejected before mutation by the artifact-access bridge.
!?FU(CFS_AiPrune);
!#VA(hero:x);
!!FU|(hero)<0/(hero)>155:E;
!!HE(hero):O?(owner:y);
!!FU|(owner)<0/(owner)>7:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)>0:E;
!!re (pass:y)/0/82;
 !!VR(slot:y):S82 -(pass);
 !!FU(GetArtAtSlot):P(hero)/(slot)/?(art:y)/?i;
 !!co|(art)<450/(art)>530;
 !!FU(CLT_RemoveOne):P(hero)/(art);
!!en;

!?FU(CFS_AiGuardStatus);
!!SN:W^cfs.ai.block^/1;
!!SN:L^cfs_relic_book.era^/?(library:y);
!!VR(status:y):S0;
!!if&(library)>0;
 !!SN:A(library)/^CFSArtifactGuardReady^/?(query:y);
 !!if&(query)>0;
  !!VR(savedV1:y):Sv1;
  !!SN:E(query)/(CALLCONV_STDCALL);
  !!VR(status):Sv1;
  !!VRv1:S(savedV1);
 !!en;
!!en;
!!SN:W^cfs.ai.guard.ready^/(status);
!!SN:F^WriteStrToIni^/^artifact_guard^/^%(status)^/^native^/^Debug\CloudTitansAccess.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansAccess.ini^;
!!IF&(status)=0:M^Cloud Titans: AI artifact protection is unavailable. Stop this test and keep the Debug folder.^;

!?FU(OnStartOrLoad);
!!FU(CFS_AiGuardStatus):P;
!!FU(GetMaxHeroId):P?(last:y);
!!re (hero:y)/0/(last);
 !!FU(CFS_AiPrune):P(hero);
!!en;

!?FU(OnBeforeBattleUniversal);
!!BA:H0/?(attacker:y) H1/?(defender:y);
!!FU(CFS_AiPrune):P(attacker);
!!FU(CFS_AiPrune):P(defender);

!?FU(OnEveryDay);
!#VA(day:x) (weekDay:x) (once:x) (owner:x) (isAi:x);
!!FU&(isAi)=0:E;
!!FU(GetMaxHeroId):P?(last:y);
!!re (hero:y)/0/(last);
 !!FU(CFS_AiPrune):P(hero);
!!en;

; A repeated world packet may confirm an identity, never rewrite an index or
; coordinate already assigned to a different component. No new wire/schema.
!?FU(CFS_WorldError);
!!SN:W^clt.net.world.error^/1;
!!SN:F^WriteStrToIni^/^world_error^/^1^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansNetwork.ini^;

!?FU(CFS_WorldPacketReady);
!#VA(index:x) (bx:x) (by:x) (bz:x) (previous:x) (part:x) (ready:x);
!!VR(ready):S1;
!!SN:W^clt.net.world.complete^/?(complete:y) W^clt.world.placed^/?(count:y);
!!VR(ready)&(complete)>0/(index)>(count):S0;
!!SN:W^clt.world.p.%(index).art^/?(recorded:y) W^clt.pickup.site.%(bx).%(by).%(bz)^/?(known:y);
!!VR(ready)&(known)>0/(known)<>(index):S0;
!!if&(recorded)>0;
 !!SN:W^clt.world.p.%(index).x^/?(px:y) W^clt.world.p.%(index).y^/?(py:y) W^clt.world.p.%(index).z^/?(pz:y) W^clt.world.p.%(index).old^/?(old:y);
 !!VR(ready)|(recorded)<>(part)/(px)<>(bx)/(py)<>(by)/(pz)<>(bz)/(old)<>(previous):S0;
!!en;
!!FU(CFS_WorldError)&(ready)=0:P;

; Completion certifies a complete coordinate/component ledger, not merely the
; sender's declared count. Incomplete streams stop the test, never auto-repair.
!?FU(CFS_WorldPlanReady);
!#VA(count:x) (ready:x);
!!VR(ready):S0;
!!FU|(count)<0/(count)>140:E;
!!SN:W^clt.net.world.complete^/?(complete:y) W^clt.world.placed^/?(savedCount:y);
!!FU&(complete)>0/(count)<>(savedCount):E;
!!UN:X?(size:y)/?(underground:y);
!!VR(above:y):S0;
!!VR(below:y):S0;
!!re (index:y)/1/(count);
 !!SN:W^clt.world.p.%(index).x^/?(px:y) W^clt.world.p.%(index).y^/?(py:y) W^clt.world.p.%(index).z^/?(pz:y) W^clt.world.p.%(index).old^/?(old:y) W^clt.world.p.%(index).art^/?(part:y);
 !!FU(CFS_IsComponent):P(part)/?(valid:y);
 !!FU|(valid)=0/(px)<0/(py)<0/(px)>=(size)/(py)>=(size)/(pz)<0/(pz)>(underground)/(old)<7/(old)>128:E;
 !!SN:W^clt.pickup.site.%(px).%(py).%(pz)^/?(known:y);
 !!FU&(known)<>(index):E;
 !!VR(above)&(pz)=0:+1;
 !!VR(below)&(pz)=1:+1;
!!en;
; A lower completion count must not hide already received trailing sites.
!!VR(firstExtra:y):S(count) +1;
!!if&(firstExtra)<=140;
 !!re (extra:y)/(firstExtra)/140;
  !!SN:W^clt.world.p.%(extra).art^/?(extraPart:y);
  !!FU&(extraPart)>0:E;
 !!en;
!!en;
!!FU&(underground)>0/(above)<>(below):E;
!!SN:W^clt.net.world.layer.0^/(above) W^clt.net.world.layer.1^/(below);
!!VR(ready):S1;

; Before starting an underground/surface pair, reserve the ability to finish it.
; Spacing is layer-local, so the first placement cannot invalidate the second.
!?FU(CFS_WorldLayerReady);
!#VA(spacing:x) (layer:x) (ready:x);
!!VR(ready):S0;
!!SN:W^clt.world.pool^/?(pool:y);
!!re (index:y)/1/(pool);
 !!SN:W^clt.world.c.%(index).used^/?(used:y) W^clt.world.c.%(index).z^/?(z:y);
 !!co|(used)>0/(z)<>(layer);
 !!SN:W^clt.world.c.%(index).x^/?(x:y) W^clt.world.c.%(index).y^/?(y:y) W^clt.world.c.%(index).old^/?(old:y);
 !!OB(x)/(y)/(z):T?(kind:y) U?(current:y);
 !!co|(kind)<>(OBJ_ARTIFACT)/(current)<>(old);
 !!SN:W^clt.pickup.site.%(x).%(y).%(z)^/?(existing:y);
 !!co&(existing)>0;
 !!FU(CLT_WorldSpacing):P(x)/(y)/(z)/(spacing)/?(okay:y);
 !!if&(okay)=1;
  !!VR(ready):S1;
  !!FU:E;
 !!en;
!!en;

; A nominal budget increase alone cannot help a spacing-limited map. Add at
; most ten percent to that first plan, relaxing only the extra sites down to
; the existing minimum four-tile separation. Keep the declared density cap.
!?FU(CFS_WorldBudget);
!#VA(old:x) (underground:x) (count:x);
!!VR(count):S(old) F0/1000000;
!!if&(underground)>0;
 !!VR(count)::2 *110 +99 :100 *2;
!!el;
 !!VR(count):*110 +99 :100;
!!en;

!?FU(CFS_WorldTopUp);
!#VA(size:x) (limit:x) (underground:x);
!!SN:W^clt.world.placed^/?(placed:y) W^clt.world.error^/?(error:y);
!!FU|(placed)=0/(error)>0:E;
!!FU(CFS_WorldBudget):P(placed)/(underground)/?(target:y);
!!VR(target)&(target)>(limit):S(limit);
!!VR(target)&(underground)>0::2 *2;
!!VR(spacing:y):S(size) :12 F4/1000;
!!VR(attempts:y):S(spacing) -4;
!!FU&(attempts)<1:E;
!!re (attempt:y)/1/(attempts);
 !!SN:W^clt.world.placed^/?(placed) W^clt.world.error^/?(error);
 !!FU|(placed)>=(target)/(error)>0:E;
 !!VR(gap:y):S(spacing) -(attempt);
 !!VR(needed:y):S(target) -(placed);
 !!FU(CLT_WorldPlace):P(size)/(needed)/(gap);
!!en;

; Generation only: if the surface half fails, restore the last underground site.
; It has not been broadcast or exposed to players yet.
!?FU(CFS_UndoWorldPair);
!!SN:W^clt.world.placed^/?(placed:y);
!!FU&(placed)<=0:E;
!!SN:W^clt.world.p.%(placed).x^/?(bx:y) W^clt.world.p.%(placed).y^/?(by:y) W^clt.world.p.%(placed).z^/?(bz:y) W^clt.world.p.%(placed).old^/?(old:y) W^clt.world.p.%(placed).candidate^/?(candidate:y);
!!FU|(bz)<>1/(old)<7/(old)>128/(candidate)<1/(candidate)>2048:E;
!!SN:W^clt.pickup.site.%(bx).%(by).%(bz)^/?(known:y);
!!FU&(known)<>(placed):E;
!!OB(bx)/(by)/(bz):T?(kind:y) U?(actual:y);
!!FU|(kind)<>(OBJ_ARTIFACT)/(actual)<>(old):E;
!!UN:O(bx)/(by)/(bz)/1/0;
!!UN:I(bx)/(by)/(bz)/(OBJ_ARTIFACT)/(old)/(OBJ_ARTIFACT)/(old)/-1/0;
!!OB(bx)/(by)/(bz):C0;
!!SN:H^-object^/(bx)/(by)/(bz)/^^;
!!SN:W^clt.pickup.site.%(bx).%(by).%(bz)^/0 W^clt.world.c.%(candidate).used^/0;
!!SN:W^clt.world.p.%(placed).x^/0 W^clt.world.p.%(placed).y^/0 W^clt.world.p.%(placed).z^/0 W^clt.world.p.%(placed).old^/0 W^clt.world.p.%(placed).art^/0 W^clt.world.p.%(placed).candidate^/0;
!!SN:W^cfs.world.layer.%(bz)^/?(layerIndex:y);
!!VR(layerIndex):-1 F0/140;
!!SN:W^cfs.world.layer.%(bz)^/(layerIndex);
!!VR(placed):-1;
!!SN:W^clt.world.placed^/(placed);

!?FU(CFS_LayerPart);
!#VA(index:x) (layer:x) (size:x) (art:x);
!!VR(quarter:y):S(index) :4;
!!VR(rare:y):S(index) %4;
!!if&(rare)=3;
 !!VR(index):S(quarter);
 !!VR(layer):S1 -(layer);
!!el;
 !!VR(index):-(quarter);
!!en;
!!VR(town:y):S(index) %6;
!!VR(part:y):S(index) :6 *5;
!!if&(layer)=1;
 !!VR(town):S(index) %3 +3;
 !!VR(part):S(index) :3 *5;
!!el;
 !!VR(town)&(town)>=3:+3;
!!en;
!!VR(offset:y):S(size) :36 %8;
!!VR(part):+(offset) %8;
!!VR(art):S450 +(part);
