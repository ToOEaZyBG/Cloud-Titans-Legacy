ZVSE2
; Local exploration prototype. Shared GEM town menu and result hook.
; Persistent counters belong to the player, rewards once per player/part.

!?FU(CLT_QuestLocal);
!#VA(ok:x);
!!UN:V?i/?i/?i/?(network:y)/?i;
!!VR(ok):S1;
; Network mutations are handled by the shared RPC layer.

!?FU(gem_OnOpenButtonDlg);
!!FU(CLT_QuestLocal):P?(okay:y);
!!FU&(okay)=0:E;
!!CA-1:T?(townType:y) O?(owner:y);
!!OW:C?(active:y);
!!FU|(townType)<>(TOWN_TOWER)/(owner)<>(active):E;
!!OW:I(owner)/?(ai:y);
!!FU&(ai)>0:E;
!!FU(CLT_IsLocalOwner):P(owner)/?(localOwner:y);
!!FU&(localOwner)=0:E;
!!FU(gem_AddTownButton):P^cltquest.def^/64/32/^Cloud Titans quests^/^Eight quests - eight set components^/^Complete a quest and claim its component once per player.^/(CLT_QuestMenu)/0/0/0;

!?FU(CLT_QuestInfo);
!#VA(quest:x) (target:x) (title:x) (objective:x);
!!if&(quest)=0;
 !!VR(target):S328;
 !!VR(title):Z^Crown of the Cloud Sovereign^;
 !!VR(objective):Z^Win 328 battles.^;
!!en;
!!if&(quest)=1;
 !!VR(target):S2617;
 !!VR(title):Z^Thunder Scepter^;
 !!VR(objective):Z^Defeat 2617 Liches or Power Liches.^;
!!en;
!!if&(quest)=2;
 !!VR(target):S6542;
 !!VR(title):Z^Aegis of the Sky^;
 !!VR(objective):Z^Defeat 6542 Skeletons or Skeleton Warriors.^;
!!en;
!!if&(quest)=3;
 !!VR(target):S65408;
 !!VR(title):Z^Armor of the Ancient Titan^;
 !!VR(objective):Z^Defeat 65408 enemy creatures of any kind.^;
!!en;
!!if&(quest)=4;
 !!VR(target):S1309;
 !!VR(title):Z^Mantle of the Aurora^;
 !!VR(objective):Z^Defeat 1309 Vampires or Vampire Lords.^;
!!en;
!!if&(quest)=5;
 !!VR(target):S656;
 !!VR(title):Z^Boots of the Snow Wanderer^;
 !!VR(objective):Z^Win 656 battles.^;
!!en;
!!if&(quest)=6;
 !!VR(target):S99;
 !!VR(title):Z^Pendant of the Celestial Forge^;
 !!VR(objective):Z^Defeat 99 Behemoths, Ancient Behemoths or Ghost Behemoths.^;
!!en;
!!if&(quest)=7;
 !!VR(target):S6542;
 !!VR(title):Z^Ring of the Storm^;
 !!VR(objective):Z^Defeat 6542 Imps or Familiars.^;
!!en;

!?FU(CLT_QuestMetric);
!#VA(quest:x) (metric:x);
!!VR(metric):Z^progress^;
!!VR(metric)&(quest)=0:Z^battle wins^;
!!VR(metric)&(quest)=1:Z^Liches / Power Liches defeated^;
!!VR(metric)&(quest)=2:Z^Skeletons / Skeleton Warriors defeated^;
!!VR(metric)&(quest)=3:Z^enemy creatures defeated^;
!!VR(metric)&(quest)=4:Z^Vampires / Vampire Lords defeated^;
!!VR(metric)&(quest)=5:Z^battle wins^;
!!VR(metric)&(quest)=6:Z^Behemoths defeated (all 3 forms)^;
!!VR(metric)&(quest)=7:Z^Imps / Familiars defeated^;

!?FU(CLT_QuestProgressKey);
!#VA(owner:x) (quest:x) (key:x);
!!VR(key):Z^clt.quest.%(owner).progress.%(quest)^;
; The old genie ledger must never count as Behemoth kills.
!!VR(key)&(quest)=6:Z^clt.quest.%(owner).progress.behemoths^;

; Read numeric quest state in one place. Do not carry string-key outputs
; across nested/modal UI calls, which may replace temporary strings.
!?FU(CLT_QuestState);
!#VA(owner:x) (quest:x) (progress:x) (claimed:x);
!!FU(CFS_QuestState):P(owner)/8/(quest)/?(progress)/?(claimed);

!?FU(CLT_QuestTownRequirements);
!#VA(town:x) (missing:x);
!!VR(missing):S0;
; Tower's 36 ordinary building IDs. Excludes shipyard (not a Tower building),
; void/cosmetic slots, non-Tower horde slots and Grail/Skyship (26).
; Native WOG helper handles upgraded versions of multilevel buildings.
!!re (building:y)/0/43;
 !!co|(building)=6/(building)=20;
 !!co&(building)>=24/(building)<=29;
 !!FU(WOG_Town_IsBuildingBuilt):P(town)/(building)/?(built:y);
 !!VR(missing)&(built)=0:+1;
!!en;

!?FU(CLT_QuestRequirements);
!#VA(quest:x) (hero:x) (ready:x) (status:x);
!!VR(level:y):S0;
!!HE(hero)&(hero)>=0:E?i/?(level);
!!VR(heroStatus:z):S^No hero in this Tower. Bring a level 25+ hero to claim.^;
!!VR(heroStatus)&(hero)>=0:S^Hero level: %(level)/25^;
!!CA-1:U?(town:y);
!!FU(CLT_QuestTownRequirements):P(town)/?(missing:y);
!!VR(heroTown:y):S-1;
!!if&(hero)>=0;
 !!HE(hero):B2/?(heroClass:y);
 !!VR(heroTown):S(heroClass) :2;
!!en;
!!VR(heroStatus)&(heroTown)<>(TOWN_TOWER):S^Bring a Tower hero to claim this component.^;
!!VR(ready):S1;
!!VR(ready)|(level)<25/(missing)>0/(heroTown)<>(TOWN_TOWER):S0;
!!VR(status):Z^%(heroStatus)
This Tower: all ordinary buildings required (including Mage Guild 5).
Missing buildings: %(missing). Skyship/Grail is not required.^;

; Ownership is informational. A found component never consumes its quest.
!?FU(CLT_PlayerOwnedParts);
!#VA(owner:x) (mask:x);
!!VR(mask):S0;
!!FU|(owner)<0/(owner)>7:E;
!!FU(GetMaxHeroId):P?(last:y);
!!re (hero:y)/0/(last);
 !!HE(hero):O?(heroOwner:y);
 !!co&(heroOwner)<>(owner);
 !!HE(hero):A2/458/?(relic:y)/?i;
 !!if&(relic)>0;
  !!VR(mask):S255;
  !!FU:E;
 !!en;
 !!re (part:y)/0/7;
  !!VR(artifact:y):S450 +(part);
  !!HE(hero):A2/(artifact)/?(count:y)/?i;
  !!if&(count)>0;
   !!VR(bit:y):S1 Sd<<(part);
   !!VR(mask):|(bit);
  !!en;
 !!en;
!!en;

!?FU(CLT_QuestMenu);
!!FU(CQT_ComponentMenu):P;

!?FU(OnStartOrLoad);
!!SN:L^erm_hooker.era^/?(library:y);
!!FU&(library)=0:E;
!!SN:A(library)/^SetHook^/?(setHook:y);
!!FU&(setHook)=0:E;
; Same shared result-entry hook as ACM_OnBeforeBattleResult.
!!SN:E(setHook)/1/4681149/(CLT_QuestBattleResult);

!?FU(OnBeforeBattleUniversal);
!!SN:W^clt.quest.snapshot^/0 W^clt.quest.pending^/0 W^cgc.battle.pending^/0;

!?FU(OnBattleReplay);
!!SN:W^clt.quest.snapshot^/0 W^clt.quest.pending^/0 W^cgc.battle.pending^/0;

!?BF;
!!FU(CLT_QuestLocal):P?(okay:y);
!!FU&(okay)=0:E;
!!BA:A?(simulation:y);
!!FU&(simulation)>0:E;
!!SN:W^clt.quest.snapshot^/?(ready:y);
!!FU&(ready)>0:E;
!!re (slot:y)/0/41;
 !!BM(slot):T?(type:y) N?(number:y) F?(flags:y);
 !!VR(summoned:y):S(flags) &4194304;
 !!VR(number)|(summoned)>0/(type)<0:S0;
 !!SN:W^clt.quest.start.%(slot).type^/(type) W^clt.quest.start.%(slot).number^/(number);
!!en;
!!SN:W^clt.quest.snapshot^/1;

!?FU(CLT_QuestBattleResult);
!#VA(hook:x);
!!SN:W^clt.quest.pending^/0 W^clt.quest.snapshot^/?(ready:y);
!!FU&(ready)=0:E;
!!UN:C(hook)/(STRUCT_HOOK_CONTEXT_EBP)/4/?(ebp:y) C(ebp)/8/4/?(winner:y);
!!FU|(winner)<0/(winner)>1:E;
!!BA:H(winner)/?(hero:y);
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(localOwner:y);
!!FU&(localOwner)=0:E;
!!FU(CFH_StageBattle):P(owner)/(hero);
!!VR(loser:y):S1 -(winner);
!!re (q:y)/0/7;
 !!SN:W^clt.quest.delta.%(q)^/0;
!!en;
!!SN:W^clt.quest.delta.0^/1 W^clt.quest.delta.5^/1;
!!FU(CFS_ClearDeltas):P;
!!VR(first:y):S(loser) *21;
!!VR(last:y):S(first) +20;
!!re (slot:y)/(first)/(last);
 !!SN:W^clt.quest.start.%(slot).type^/?(originalType:y) W^clt.quest.start.%(slot).number^/?(original:y);
 !!BM(slot):T?(type:y) N?(living:y);
 !!if&(original)>0/(type)=(originalType);
  !!VR(killed:y):S(original) -(living) F0/(original);
  !!FU(CFS_StageKill):P(type)/(killed);
  !!FU(CFS_StageTowerKill):P3/(killed);
  !!FU(CFS_StageTowerKill)|(type)=64/(type)=65:P1/(killed);
  !!FU(CFS_StageTowerKill)|(type)=56/(type)=57:P2/(killed);
  !!FU(CFS_StageTowerKill)|(type)=62/(type)=63:P4/(killed);
  !!FU(CFS_StageTowerKill)|(type)=(MON_BEHEMOTH)/(type)=(MON_ANCIENT_BEHEMOTH)/(type)=(MON_GHOST_BEHEMOTH):P6/(killed);
  !!FU(CFS_StageTowerKill)|(type)=42/(type)=43:P7/(killed);
 !!en;
!!en;
!!SN:W^cgc.battle.pending.hero^/(hero) W^cgc.battle.pending^/1;
!!SN:W^clt.quest.pending.hero^/(hero) W^clt.quest.pending.owner^/(owner) W^clt.quest.pending^/1;

!?FU(OnAfterBattleUniversal);
!!SN:W^clt.quest.pending^/?(pending:y);
!!FU&(pending)=0:E;
!!SN:W^clt.quest.pending^/0 W^clt.quest.snapshot^/0 W^clt.quest.pending.owner^/?(owner:y);
!!FU(CFS_Commit):P(owner);
!!FU(CFH_CommitBattle):P(owner);
!!SN:W^cgc.battle.pending.hero^/?(rewardHero:y);
!!FU(CGC_RollBattle):P(rewardHero)/(owner);
!!FU:E;
!!re (q:y)/0/7;
 !!FU(CLT_QuestProgressKey):P(owner)/(q)/?(key:z);
 !!SN:W^clt.quest.delta.%(q)^/?(amount:y) W(key)/?(old:y);
 !!VR(old):+(amount) F0/1000000000;
 !!UN:V?i/?i/?i/?(network:y)/?i;
 !!if&(network)>0;
  !!FU26892:P(owner)/(q)/(old);
  !!IP:D-1;
  !!FU26892:D(owner)/(q)/(old);
 !!el;
  !!FU(CLT_QuestProgressSet):P(owner)/(q)/(old);
 !!en;
 !!SN:W(key)/?(applied:y);
 !!SN&(applied)<(old):W^clt.net.quest.error^/1;
 !!SN:F^WriteStrToIni^/^player%(owner)_quest%(q)^/^%(applied)^/^progress^/^Debug\CloudTitansQuests.ini^;
!!en;
!!SN:F^WriteStrToIni^/^stage^/^battle-committed^/^battle^/^Debug\CloudTitansQuests.ini^;
!!SN:F^WriteStrToIni^/^owner^/^%(owner)^/^battle^/^Debug\CloudTitansQuests.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansQuests.ini^;
