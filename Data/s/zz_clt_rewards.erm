ZVSE2
; DEVELOPMENT repair: validate every selection; fail closed before grants/dialogs.
; Human components: guaranteed on levels18,23,28,... with option126.

!?FU(CLT_LevelArtifact);
!#VA(hero:x) (rank:x) (artifact:x) (step:x);
!!VR(savedQuickI:y):Si;
!!HE(hero)&(hero)=(CURRENT_HERO):N?(hero);
!!VR(rewardLevel:y):Si^wog_101_startLvl^;
!!VR(offset:y):S(step) :2;
!!VR(rewardLevel):+(offset);
!!FU(CLT_TryLevelComponent):P(hero)/(rank)/?(artifact)/(rewardLevel);
!!if&(artifact)<0;
 !!FU(CLT_IsHuman):P(hero)/?(human:y);
 ; Human Relics were already selected with the scheduled component gate. An empty
 ; ordinary pool must not get a second native draw into custom components.
 !!if|(human)=0/(rank)<>(ART_LEVEL_RELIC);
  !!UN:J6/(rank)/?(artifact);
 !!en;
!!en;
!!FU(CLT_ValidLevelArtifact):P(hero)/(rank)/(artifact)/?(valid:y);
!!if&(valid)=0;
 !!FU(CLT_StockLevelArtifact):P(hero)/(rank)/(rewardLevel)/?(artifact);
!!en;
!!VRi:S(savedQuickI);

!?FU(CLT_TryLevelComponent);
!#VA(hero:x) (rank:x) (artifact:x) (rewardLevel:x);
!!VR(artifact):S-1;
!!FU&(rank)<>(ART_LEVEL_RELIC):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!FU&(rewardLevel)<18:E;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!FU(CLT_NetworkRewardAllowed):P0/(rewardLevel)/?(component:y);
!!VR(key:y):S(hero);
!!if&(network)>0;
 ; Map salt is shared by the existing map plan. No extra RNG or grant RPC.
 !!SN:W^clt.net.world.hash^/?(salt:y);
 !!VR(key):+(salt) %65521;
!!el;
 !!SN:W^clt.reward.last.%(hero)^/?(lastReward:y);
 !!VR(component)&(lastReward)>=(rewardLevel):S0;
!!en;
!!SN:F^WriteStrToIni^/^last_hero^/^%(hero)^/^attempt^/^Debug\CloudTitansRewards.ini^;
!!SN:F^WriteStrToIni^/^last_level^/^%(rewardLevel)^/^attempt^/^Debug\CloudTitansRewards.ini^;
!!SN:F^WriteStrToIni^/^last_component_selected^/^%(component)^/^attempt^/^Debug\CloudTitansRewards.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansRewards.ini^;
!!if&(component)>0;
 !!if&(network)>0;
  !!FU(CLT_LevelTicket):P(key)/(rewardLevel)/7/?(partTicket:y);
 !!el;
  !!VR(partTicket):R0/0/7;
 !!en;
 !!FU(CFS_MissingLevelPart):P(hero)/(partTicket)/?(artifact);
 !!if&(artifact)>=0;
 !!SN:W^clt.reward.last.%(hero)^/(rewardLevel);
 !!SN:W^clt.reward.level.count^/?(count:y);
 !!VR(count):+1;
 !!SN:W^clt.reward.level.count^/(count);
 !!SN:F^WriteStrToIni^/^reward%(count)^/^hero=%(hero),level=%(rewardLevel),artifact=%(artifact)^/^level-up^/^Debug\CloudTitansRewards.ini^;
 !!SN:F^SaveIni^/^Debug\CloudTitansRewards.ini^;
 !!FU:E;
 !!en;
!!en;
!!FU(CLT_StockLevelArtifact):P(hero)/(rank)/(rewardLevel)/?(artifact);

; Native random decks may return a sentinel. Select from live allowed stock
; definitions when a direct selection is required; an empty pool stays -1.
!?FU(CLT_StockLevelArtifact);
!#VA(hero:x) (rank:x) (rewardLevel:x) (artifact:x);
!!VR(artifact):S-1;
!!FU|(rank)<2/(rank)>16:E;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!VR(key:y):S(hero);
!!SN:W^clt.net.world.hash^/?(salt:y);
!!VR(key)&(network)>0:+(salt) %65521;
!!VR(stock:y):S0;
!!re (candidate:y)/7/128;
 !!UN:A(candidate)/?(banned:y) A(candidate)/3/?(candidateRank:y);
 !!VR(stock)&(banned)=0/(candidateRank)=(rank):+1;
!!en;
!!FU&(stock)=0:E;
!!VR(last:y):S(stock) -1;
!!if&(network)>0;
 !!FU(CLT_LevelTicket):P(key)/(rewardLevel)/(last)/?(ticket:y);
!!el;
 !!VR(ticket):R0/0/(last);
!!en;
!!VR(index:y):S0;
!!re (normal:y)/7/128;
 !!UN:A(normal)/?(disabled:y) A(normal)/3/?(normalRank:y);
 !!if&(disabled)=0/(normalRank)=(rank);
  !!if&(index)=(ticket);
   !!VR(artifact):S(normal);
   !!br;
  !!en;
  !!VR(index):+1;
 !!en;
!!en;

; Never query native UN:A with a custom/out-of-range ID. Custom components
; use this package's declared range; they require a human Relic reward.
!?FU(CLT_ValidLevelArtifact);
!#VA(hero:x) (rank:x) (artifact:x) (valid:x);
!!VR(valid):S0;
!!FU(CFS_IsComponent):P(artifact)/?(component:y);
!!if&(component)>0/(rank)=(ART_LEVEL_RELIC);
 !!FU(CLT_IsHuman):P(hero)/?(valid);
 !!FU:E;
!!en;
!!FU|(artifact)<7/(artifact)>128:E;
!!UN:A(artifact)/?(banned:y) A(artifact)/3/?(actualRank:y);
!!VR(valid)&(banned)=0/(actualRank)=(rank):S1;

; Shared fixed schedule, independent of map salt, RNG and query order.
!?FU(CLT_NetworkRewardAllowed);
!#VA(key:x) (level:x) (allowed:x);
!!VR(allowed):S0;
!!FU|(key)<0/(level)<18/(level)>104:E;
!!VR(remainder:y):S(level) -18 %5;
!!VR(allowed)&(remainder)=0:S1;

; Small bounded integer hash. The first argument is a salted selection key.
!?FU(CLT_LevelTicket);
!#VA(hero:x) (level:x) (last:x) (ticket:x);
!!VR(ticket):S-1;
!!FU|(hero)<0/(level)<1/(last)<0:E;
!!VR(seed:y):S(hero) +1 %65521 *25173 %65521;
!!VR(term:y):S(level) %65521 *7919 %65521;
!!VR(seed):+(term) %65521;
!!VR(divisor:y):S(last) +1;
!!VR(ticket):S(seed) %(divisor);
