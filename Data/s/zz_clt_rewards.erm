ZVSE2
; WoG option 126 integration: native code alone grants and displays rewards.
; Human components: 5% per eligible reward, at least ten levels apart.

!?FU(CLT_LevelArtifact);
!#VA(hero:x) (rank:x) (artifact:x) (step:x);
!!VR(savedQuickI:y):Si;
!!HE(hero)&(hero)=(CURRENT_HERO):N?(hero);
!!VR(rewardLevel:y):Si^wog_101_startLvl^;
!!VR(offset:y):S(step) :2;
!!VR(rewardLevel):+(offset);
!!FU(CLT_TryLevelComponent):P(hero)/(rank)/?(artifact)/(rewardLevel);
!!UN&(artifact)<0:J6/(rank)/?(artifact);
!!VRi:S(savedQuickI);

!?FU(CLT_TryLevelComponent);
!#VA(hero:x) (rank:x) (artifact:x) (rewardLevel:x);
!!VR(artifact):S-1;
!!FU&(rank)<>(ART_LEVEL_RELIC):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!FU&(rewardLevel)<18:E;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!VR(component:y):S0;
!!VR(key:y):S(hero);
!!if&(network)>0;
 ; Map salt is shared by the existing map plan. No extra RNG or grant RPC.
 !!SN:W^clt.net.world.hash^/?(salt:y);
 !!VR(key):+(salt) %65521;
 !!FU(CLT_NetworkRewardAllowed):P(key)/(rewardLevel)/?(component);
!!el;
 !!SN:W^clt.reward.last.%(hero)^/?(lastReward:y);
 !!VR(nextLevel:y):S(lastReward) +10;
 !!if|(lastReward)=0/(rewardLevel)>=(nextLevel);
  !!VR(roll:y):R0/0/99;
  !!VR(component)&(roll)<5:S1;
 !!en;
!!en;
!!if&(component)>0;
 !!if&(network)>0;
  !!FU(CLT_LevelTicket):P(key)/(rewardLevel)/7/?(partTicket:y);
 !!el;
  !!VR(partTicket):R0/0/7;
 !!en;
 !!VR(artifact):S450 +(partTicket);
 !!SN:W^clt.reward.last.%(hero)^/(rewardLevel);
 !!SN:W^clt.reward.level.count^/?(count:y);
 !!VR(count):+1;
 !!SN:W^clt.reward.level.count^/(count);
 !!SN:F^WriteStrToIni^/^reward%(count)^/^hero=%(hero),level=%(rewardLevel),artifact=%(artifact)^/^level-up^/^Debug\CloudTitansRewards.ini^;
 !!SN:F^SaveIni^/^Debug\CloudTitansRewards.ini^;
 !!FU:E;
!!en;
; Select actual allowed stock Relic IDs directly, avoiding exhausted-deck
; sentinel rewards on the human Relic path. Other native classes are unchanged.
!!VR(stock:y):S0;
!!re (candidate:y)/7/128;
 !!UN:A(candidate)/?(banned:y) A(candidate)/3/?(candidateRank:y);
 !!VR(stock)&(banned)=0/(candidateRank)=(ART_LEVEL_RELIC):+1;
!!en;
!!FU&(stock)=0:E;
!!VR(last:y):S(stock) -1;
!!if&(network)>0;
 !!FU(CLT_LevelTicket):P(key)/(rewardLevel)/(last)/?(ticket:y);
!!el;
 !!VR(ticket):R0/0/(last);
!!en;
!!VR(index:y):S0;
!!re (normal:y)/7/128;
 !!UN:A(normal)/?(disabled:y) A(normal)/3/?(normalRank:y);
 !!if&(disabled)=0/(normalRank)=(ART_LEVEL_RELIC);
  !!if&(index)=(ticket);
   !!VR(artifact):S(normal);
   !!br;
  !!en;
  !!VR(index):+1;
 !!en;
!!en;

; Recompute the per-map/per-hero schedule, making it independent of RPC
; arrival order or a peer-local cooldown. The saved last level is diagnostic
; online and authoritative for local random selection. A candidate succeeds
; only with a roll below 5 and no scheduled component in the previous 9 levels.
!?FU(CLT_NetworkRewardAllowed);
!#VA(key:x) (level:x) (allowed:x);
!!VR(allowed):S0;
!!FU|(key)<0/(level)<18/(level)>104:E;
!!VR(previous:y):S-10;
!!re (walk:y)/18/(level);
 !!VR(next:y):S(previous) +10;
 !!co&(walk)<(next);
 !!FU(CLT_LevelTicket):P(key)/(walk)/99/?(roll:y);
 !!VR(previous)&(roll)<5:S(walk);
!!en;
!!VR(allowed)&(previous)=(level):S1;

; Small bounded integer hash. The first argument is a salted selection key.
!?FU(CLT_LevelTicket);
!#VA(hero:x) (level:x) (last:x) (ticket:x);
!!VR(ticket):S-1;
!!FU|(hero)<0/(level)<1/(last)<0:E;
!!VR(seed:y):S(hero) +1 %65521 *25173 %65521;
!!VR(term:y):S(level) %65521 *7919 %65521;
!!VR(seed):+(term) %65521;
!!VR(divisor:y):S(last) +1;
!!VR(ticket):S(seed) %(divisor);
