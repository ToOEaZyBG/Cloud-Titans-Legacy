ZVSE2
; Map proxies retain a native artifact ID for third-party visit hooks.
; Their coordinate ledger, not the native reward, identifies the component.

!?OB5;
!!VR(bx:y):Sv998;
!!VR(by:y):Sv999;
!!VR(bz:y):Sv1000;
!!SN:W^clt.pickup.site.%(bx).%(by).%(bz)^/?(index:y);
!!FU&(index)<1:E;
!!HE-1:N?(hero:y);
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
; Disable native pickup before doing anything: failed delivery leaves a retryable site.
!!OB(bx)/(by)/(bz):S;
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!FU26897:P(hero)/(index)/(bx)/(by)/(bz);
!!if&(network)>0;
 !!IP:D-1;
 !!FU26897:D(hero)/(index)/(bx)/(by)/(bz);
!!en;
!!SN:W^clt.world.p.%(index).taken^/?(taken:y);
!!if&(taken)=0;
 !!IF:M^The component was not collected. Free a backpack space and try again.^;
!!el;
 !!SN:W^clt.world.p.%(index).art^/?(part:y);
 !!VR(quest:y):S(part) -450;
 !!if&(part)<459;
  !!FU(CLT_QuestInfo):P(quest)/?i/?(name:z)/?i;
 !!el;
  !!FU(CFS_Item):P(part)/?(name)/?i/?i/?i/?i/?i;
 !!en;
 !!IF:Q1/8/(part)/1^You found %(name).^;
!!en;

!?FU26897;
!!FU(CLT_CollectSite):Px1/x2/x3/x4/x5;

!?FU(CLT_CollectSite);
!#VA(hero:x) (index:x) (bx:x) (by:x) (bz:x);
!!FU|(hero)<0/(hero)>155/(index)<1/(index)>140:E;
!!UN:X?(size:y)/?(underground:y);
!!FU|(bx)<0/(by)<0/(bx)>=(size)/(by)>=(size)/(bz)<0/(bz)>(underground):E;
!!SN:W^clt.world.p.%(index).taken^/?(taken:y);
!!FU&(taken)>0:E;
!!SN:W^clt.world.p.%(index).x^/?(px:y) W^clt.world.p.%(index).y^/?(py:y) W^clt.world.p.%(index).z^/?(pz:y) W^clt.world.p.%(index).art^/?(part:y) W^clt.world.p.%(index).old^/?(previous:y);
!!FU|(px)<>(bx)/(py)<>(by)/(pz)<>(bz):E;
!!FU(CFS_IsComponent):P(part)/?(valid:y);
!!FU&(valid)=0:E;
!!OB(bx)/(by)/(bz):T?(kind:y) U?(actual:y);
!!FU&(kind)<>(OBJ_ARTIFACT):E;
!!FU&(actual)<>(previous)/(actual)<>(part):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!FU(CLT_BackpackCount):P(hero)/?(used:y);
!!FU&(used)>=64:E;
!!OB(bx)/(by)/(bz):S;
!!FU(CFS_CountCarried):P(hero)/(part)/?(before:y);
!!HE(hero):A4/(part);
!!FU(CFS_CountCarried):P(hero)/(part)/?(after:y);
!!FU&(after)<=(before):E;
!!VR(savedHero:y):S(hero) +1;
!!SN:W^clt.world.p.%(index).received^/(part) W^clt.world.p.%(index).hero^/(savedHero);
!!SN:F^WriteStrToIni^/^site%(index)^/^hero=%(hero),artifact=%(part),before=%(before),after=%(after),x=%(bx),y=%(by),z=%(bz)^/^pickup^/^Debug\CloudTitansPickups.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansPickups.ini^;
!!SN:W^clt.world.p.%(index).taken^/1;
!!UN:O(bx)/(by)/(bz)/1/1;
!!SN:H^-object^/(bx)/(by)/(bz)/^^;
