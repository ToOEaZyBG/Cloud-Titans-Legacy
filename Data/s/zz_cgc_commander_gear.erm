!?FU(CGC_Bonuses);
!#VA(hero:x) (attack:x) (defence:x) (damage:x) (health:x) (speed:x) (spell:x) (passive:x) (aura:x);
!!VR(attack):S0;
!!VR(defence):S0;
!!VR(damage):S0;
!!VR(health):S0;
!!VR(speed):S0;
!!VR(spell):S0;
!!VR(passive):S0;
!!VR(aura):S0;
!!FU|(hero)<0/(hero)>155:E;
!!SN:W^cgc.ready^/?(ready:y);
!!FU&(ready)<>1:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!UN:P3/?(disabled:y);
!!FU&(disabled)<>0:E;
!!CO(hero):E?(enabled:y) D?(dead:y);
!!FU|(enabled)<>1/(dead)<>0:E;
!!VR(c0:y):S0;
!!VR(c1:y):S0;
!!VR(c2:y):S0;
!!re (slot:y)/0/5;
 !!CO(hero):A3/(slot)/?(native:y)/?i;
 !!co&(native)<>0;
 !!SN:W^cgc.v1.gear.%(hero).%(slot)^/?(saved:y);
 !!VR(art:y):S(saved) -1;
 !!co|(art)<531/(art)>548;
 !!VR(itemSlot:y):S(art) -531 %6;
 !!co&(itemSlot)<>(slot);
 !!VR(kind:y):S(art) -531 :6;
 !!VR(c0)&(kind)=0:+1;
 !!VR(c1)&(kind)=1:+1;
 !!VR(c2)&(kind)=2:+1;
!!en;
!!VR(total:y):S(c0) +(c1) +(c2) *5;
!!re (kind)/0/2;
 !!VR(count:y):S(c0);
 !!VR(count)&(kind)=1:S(c1);
 !!VR(count)&(kind)=2:S(c2);
 !!VR(total)&(count)>=2:+5;
 !!VR(total)&(count)>=4:+5;
 !!VR(total)&(count)>=6:+10;
!!en;
!!VR(attack):S(total);
!!VR(defence):S(total);
!!VR(damage):S(total);
!!VR(health):S(total);
!!VR(speed):S(total);
!!VR(spell):S(total);
!!VR(passive):S(total);
!!VR(aura):S(total);
!!VR(attack)&(c0)=6:+40;
!!VR(damage)&(c0)=6:+40;
!!VR(defence)&(c1)=6:+40;
!!VR(health)&(c1)=6:+40;
!!VR(spell)&(c2)=6:+40;
!!VR(passive)&(c2)=6:+40;
!?FU(CGC_SlotName);
!#VA(slot:x) (name:x);
!!VR(name):Z^Unknown slot^;
!!VR(name)&(slot)=0:Z^Helm^;
!!VR(name)&(slot)=1:Z^Weapon^;
!!VR(name)&(slot)=2:Z^Shield^;
!!VR(name)&(slot)=3:Z^Armor^;
!!VR(name)&(slot)=4:Z^Boots^;
!!VR(name)&(slot)=5:Z^Pendant^;

!?FU(OnStartOrLoad);
!!SN:W^cgc.ready^/0 W^cgc.transaction^/0 W^cgc.hash^/0;
!!SN:L^cfs_relic_book.era^/?(library:y);
!!FU&(library)=0:E;
!!SN:A(library)/^CFSCommanderTransaction^/?(transaction:y) A(library)/^CFSCommanderBagHash^/?(hash:y);
!!FU|(transaction)=0/(hash)=0:E;
!!SN:A(library)/^CFSArtifactGuardReady^/?(query:y);
!!FU&(query)=0:E;
!!SN:E(query)/(CALLCONV_STDCALL);
!!FU&v1<>1:E;
!!SN:W^cgc.transaction^/(transaction) W^cgc.hash^/(hash) W^cgc.ready^/1;

; Multiple FU handlers run in registration order. Preserve the provider outputs.
!?FU(Check_Com_Masteries);
!#VA(hero:x) (mastery:x) (kills:x) (maxKills:x) (class:x) (attack:x) (defence:x) (damage:x) (health:x) (speed:x) (spell:x) (passive:x) (aura:x) (flatSpeed:x) (preview:x) (alternate:x);
!!FU|(alternate)<>0/(preview)<>0:E;
!!FU(CGC_Bonuses):P(hero)/?(ba:y)/?(bd:y)/?(bm:y)/?(bh:y)/?(bs:y)/?(bp:y)/?(bv:y)/?(bu:y);
!!VR(attack):+(ba);
!!VR(defence):+(bd);
!!VR(damage):+(bm);
!!VR(health):+(bh);
!!VR(speed):+(bs);
!!VR(spell):+(bp);
!!VR(passive):+(bv);
!!VR(aura):+(bu);

!?FU(CGC_Submit);
!#VA(hero:x) (op:x) (slot:x) (art:x);
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!SN:W^cgc.hash^/?(function:y);
!!FU&(function)=0:E;
!!SN:E(function)/(CALLCONV_STDCALL)/(hero);
!!VR(hash:y):Sv1;
!!SN:W^cgc.v1.gear.%(hero).%(slot)^/?(saved:y) W^cgc.v1.txn.%(hero).seq^/?(sequence:y);
!!VR(old:y):S(saved) -1;
!!VR(sequence):+1;
!!FU26909:P(hero)/(owner)/(op)/(slot)/(art)/(old)/(hash)/(sequence);
!!SN:W^cgc.result^/?(okay:y);
!!if&(okay)=0;
 !!IF:M^Cannot complete this change. Equip items from your backpack, put down any held item, and leave room when removing gear. Forging needs a level-20 hero, living commander, 50,000 Gold, 20 Wood and 20 Ore. Native commander items reserve their same slots.^;
 !!FU:E;
!!en;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!if&(network)>0;
 !!IP:D-1;
 !!FU26909:D(hero)/(owner)/(op)/(slot)/(art)/(old)/(hash)/(sequence);
!!en;

!?FU26909;
!#VA(hero:x) (owner:x) (op:x) (slot:x) (art:x) (old:x) (hash:x) (sequence:x);
!!SN:W^cgc.result^/0;
!!SN:W^cgc.ready^/?(ready:y);
!!FU&(ready)<>1:E;
!!FU|(hero)<0/(hero)>155/(slot)<0/(slot)>5/(owner)<0/(owner)>7:E;
!!HE(hero):O?(actual:y);
!!OW:C?(active:y);
!!FU|(actual)<>(owner)/(active)<>(owner):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!UN:P3/?(disabled:y);
!!CO(hero):E?(enabled:y) D?(dead:y) A3/(slot)/?(native:y)/?i;
!!VR(available:y):S0;
!!VR(available)&(disabled)=0/(enabled)=1/(dead)=0:S1;
!!VR(free:y):S0;
!!VR(free)&(native)=0:S1;
!!SN:W^cgc.transaction^/?(function:y);
!!FU&(function)=0:E;
!!SN:W^cgc.req.hero^/(hero) W^cgc.req.owner^/(owner) W^cgc.req.op^/(op) W^cgc.req.slot^/(slot) W^cgc.req.art^/(art) W^cgc.req.old^/(old) W^cgc.req.hash^/(hash) W^cgc.req.seq^/(sequence) W^cgc.req.enabled^/(available) W^cgc.req.free^/(free);
!!SN:E(function)/(CALLCONV_STDCALL);
!!SN:W^cgc.result^/v1;
!!SN&v1=0:W^cgc.network.error^/1;

!?FU(CGC_Menu);
!#VA(hero:x);
!!FU|(hero)<0/(hero)>155:E;
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!SN:W^cgc.ready^/?(ready:y);
!!IF&(ready)<>1:M^Commander equipment is unavailable on this profile.^;
!!FU&(ready)<>1:E;
!!re (page:y)/0/999;
 !!FU(RadioDlg_Reset):P;
 !!FU(RadioDlg_SetTitle):P^Commander equipment - six slots, all towns^;
 !!re (slot:y)/0/5;
  !!SN:W^cgc.v1.gear.%(hero).%(slot)^/?(saved:y);
  !!VR(art:y):S(saved) -1;
  !!FU(CGC_Info):P(art)/?(name:z)/?i;
  !!FU(CGC_SlotName):P(slot)/?(slotName:z);
  !!CO(hero):A3/(slot)/?(native:y)/?i;
  !!VR(status:z):S^^;
  !!VR(status)&(native)<>0:S^ [native item reserves this slot]^;
  !!VR(label:z):S^%(slotName): %(name)%(status)^;
  !!FU(RadioDlg_AddItem):P(label)/(slot);
 !!en;
 !!FU(RadioDlg_AddItem):P^Forge new commander gear^/6;
 !!FU(RadioDlg_AddItem):P^Set bonuses and rules^/7;
 !!FU(RadioDlg_AddCancelButton):P;
 !!FU(RadioDlg_Show):P?(selected:y)/?(choice:y)/?i;
 !!FU|(selected)<0/(choice)<0:E;
 !!FU(CGC_SlotMenu)&(choice)<6:P(hero)/(choice)/0;
 !!FU(CGC_ForgeMenu)&(choice)=6:P(hero);
 !!IF&(choice)=7:M^Only gear equipped on this page gives bonuses. A native commander item reserves the same numbered slot. Each active piece: +5 points to all eight ACM attribute modifiers. Matching 2/4/6 parts: +5/+5/+10 more to all. Full Ember Oath: +40 Attack/Damage; Iron Covenant: +40 Defense/Health; Astral Conclave: +40 Spell/Passive. All towns can use every set. No bonus on a hero, in a backpack, or for AI, a dead or disabled commander.^;
!!en;

!?FU(CGC_ForgeMenu);
!#VA(hero:x);
!!FU(RadioDlg_Reset):P;
!!FU(RadioDlg_SetTitle):P^Forge: level 20; each item 50,000 Gold +20 Wood +20 Ore^;
!!FU(RadioDlg_AddItem):P^Ember Oath - Attack / Damage^/0;
!!FU(RadioDlg_AddItem):P^Iron Covenant - Defense / Health^/1;
!!FU(RadioDlg_AddItem):P^Astral Conclave - Spell / Passive^/2;
!!FU(RadioDlg_AddCancelButton):P;
!!FU(RadioDlg_Show):P?(selected:y)/?(kind:y)/?i;
!!FU|(selected)<0/(kind)<0/(kind)>2:E;
!!FU(RadioDlg_Reset):P;
!!FU(RadioDlg_SetTitle):P^Choose a new item for your backpack^;
!!re (slot:y)/0/5;
 !!VR(art:y):S(kind) *6 +531 +(slot);
 !!FU(CGC_Info):P(art)/?(name:z)/?i;
 !!FU(RadioDlg_AddItem):P(name)/(slot);
!!en;
!!FU(RadioDlg_AddCancelButton):P;
!!FU(RadioDlg_Show):P?(selected)/?(slot)/?i;
!!FU|(selected)<0/(slot)<0/(slot)>5:E;
!!VR(art):S(kind) *6 +531 +(slot);
!!FU(CGC_Info):P(art)/?(name)/?i;
!!IF:Q1/8/(art)/2^Forge %(name) for 50,000 Gold, 20 Wood and 20 Ore? It goes into your backpack; equip it on the Commander equipment page.^;
!!FU&-1:E;
!!FU(CGC_Submit):P(hero)/1/(slot)/(art);

!?FU(CGC_SlotMenu);
!#VA(hero:x) (slot:x) (unused:x);
!!FU(RadioDlg_Reset):P;
!!FU(RadioDlg_SetTitle):P^Choose gear from your backpack for this commander slot^;
!!re (kind:y)/0/2;
 !!VR(art:y):S(kind) *6 +531 +(slot);
 !!FU(CGC_Info):P(art)/?(name:z)/?i;
 !!FU(RadioDlg_AddItem):P(name)/(art);
!!en;
!!FU(RadioDlg_AddItem):P^Unequip to backpack^/-1;
!!FU(RadioDlg_AddCancelButton):P;
!!FU(RadioDlg_Show):P?(selected:y)/?(art)/?i;
!!FU&(selected)<0:E;
!!if&(art)>=531;
 !!FU(CGC_Info):P(art)/?(name)/?i;
 !!IF:Q1/8/(art)/2^Equip %(name) from your backpack? Items carried by the hero do not give commander bonuses.^;
 !!FU&-1:E;
!!en;
!!FU(CGC_Submit):P(hero)/0/(slot)/(art);

