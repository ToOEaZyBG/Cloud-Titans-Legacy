!?FU(CGC_Submit);
!#VA(hero:x) (op:x) (slot:x) (art:x);
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!SN:W^cgc.hash^/?(function:y);
!!FU&(function)=0:E;
!!SN:E(function)/(CALLCONV_STDCALL)/(hero);
!!VR(hash:y):Sv1;
!!FU(CGC_Equipped):P(hero)/(slot)/?(old:y);
!!VR(old)|(old)<531/(old)>551:S-1;
!!SN:W^cgc.v1.txn.%(hero).seq^/?(sequence:y);
!!VR(sequence):+1;
!!FU26909:P(hero)/(owner)/(op)/(slot)/(art)/(old)/(hash)/(sequence);
!!SN:W^cgc.result^/?(okay:y);
!!if&(okay)=0;
 !!IF:M^Cannot complete this change. Put down any held item. Assembly needs all six matching parts on this commander page or in the backpack, and room for the relic. Dismantling needs the relic in the backpack and five more free cells. Forging needs a level-20 hero, living commander, 50,000 Gold, 20 Wood and 20 Ore. Native commander items reserve their same slots.^;
 !!FU:E;
!!en;
!!FU(CGC_UpdateTooltips):P(hero);
!!UN:V?i/?i/?i/?(network:y)/?i;
!!if&(network)>0;
 !!IP:D-1;
 !!FU26909:D(hero)/(owner)/(op)/(slot)/(art)/(old)/(hash)/(sequence);
!!en;

!?FU26909;
!#VA(hero:x) (owner:x) (op:x) (slot:x) (art:x) (old:x) (hash:x) (sequence:x);
!!SN:W^cgc.result^/0;
!!SN:W^cgc.ready^/?(ready:y);
!!FU&(ready)<>1:E;
!!FU|(hero)<0/(hero)>155/(slot)<0/(slot)>5/(owner)<0/(owner)>7:E;
!!HE(hero):O?(actual:y);
!!OW:C?(active:y);
!!FU|(actual)<>(owner)/(active)<>(owner):E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!UN:P3/?(disabled:y);
!!CO(hero):E?(enabled:y) D?(dead:y) A3/(slot)/?(native:y)/?i;
!!VR(available:y):S0;
!!VR(available)&(disabled)=0/(enabled)=1/(dead)=0:S1;
!!VR(free:y):S0;
!!VR(free)&(native)=0:S1;
!!SN:W^cgc.transaction^/?(function:y);
!!FU&(function)=0:E;
!!SN:W^cgc.req.hero^/(hero) W^cgc.req.owner^/(owner) W^cgc.req.op^/(op) W^cgc.req.slot^/(slot) W^cgc.req.art^/(art) W^cgc.req.old^/(old) W^cgc.req.hash^/(hash) W^cgc.req.seq^/(sequence) W^cgc.req.enabled^/(available) W^cgc.req.free^/(free);
!!SN:E(function)/(CALLCONV_STDCALL);
!!SN:W^cgc.result^/v1;
!!SN&v1=0:W^cgc.network.error^/1;

!?FU(CGC_Menu);
!#VA(hero:x);
!!FU|(hero)<0/(hero)>155:E;
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!SN:W^cgc.ready^/?(ready:y);
!!IF&(ready)<>1:M^Commander equipment is unavailable on this profile.^;
!!FU&(ready)<>1:E;
!!SN:W^cgc.native.ready^/?(nativeMode:y);
!!if&(nativeMode)=1;
 !!FU(CGC_ForgeAndRelics):P(hero);
 !!FU:E;
!!en;
!!re (page:y)/0/999;
 !!FU(CGC_UpdateTooltips):P(hero);
 !!FU(RadioDlg_Reset):P;
 !!FU(RadioDlg_SetTitle):P^Commander equipment - six slots, all towns^;
 !!re (slot:y)/0/5;
  !!SN:W^cgc.v1.gear.%(hero).%(slot)^/?(saved:y);
  !!VR(art:y):S(saved) -1;
  !!FU(CGC_Info):P(art)/?(name:z)/?i;
  !!FU(CGC_SlotName):P(slot)/?(slotName:z);
  !!CO(hero):A3/(slot)/?(native:y)/?i;
  !!VR(status:z):S^^;
  !!VR(status)&(native)<>0:S^ [native item reserves this slot]^;
  !!VR(label:z):S^%(slotName): %(name)%(status)^;
  !!FU(RadioDlg_AddItem):P(label)/(slot);
 !!en;
 !!FU(RadioDlg_AddItem):P^Forge new commander gear^/6;
 !!FU(RadioDlg_AddItem):P^Set bonuses and green N/6 progress^/7;
 !!FU(RadioDlg_AddItem):P^Assemble six parts into one relic^/8;
 !!FU(RadioDlg_AddItem):P^Dismantle a backpack relic into six parts^/9;
 !!FU(RadioDlg_AddCancelButton):P;
 !!FU(RadioDlg_Show):P?(selected:y)/?(choice:y)/?i;
 !!FU|(selected)<0/(choice)<0:E;
 !!FU(CGC_SlotMenu)&(choice)<6:P(hero)/(choice)/0;
 !!FU(CGC_ForgeMenu)&(choice)=6:P(hero);
 !!FU(CGC_AssemblyMenu)&(choice)=8:P(hero)/2;
 !!FU(CGC_AssemblyMenu)&(choice)=9:P(hero)/3;
 !!FU(CGC_ProgressMenu)&(choice)=7:P(hero);
!!en;

!?FU(CGC_ProgressMenu);
!#VA(hero:x);
!!FU(RadioDlg_Reset):P;
!!FU(RadioDlg_SetTitle):P^Commander set progress - active equipment only^;
!!re (kind:y)/0/2;
 !!FU(CGC_State):P(hero)/(kind)/?i/?(count:y);
 !!VR(relic:y):S549 +(kind);
 !!FU(CGC_Info):P(relic)/?i/?(setName:z);
 !!VR(label:z):S^{~Lime}%(setName) (%(count)/6){~} - details^;
 !!FU(RadioDlg_AddItem):P(label)/(relic);
!!en;
!!FU(RadioDlg_AddCancelButton):P;
!!FU(RadioDlg_Show):P?(selected:y)/?(relic)/?i;
!!FU|(selected)<0/(relic)<549/(relic)>551:E;
