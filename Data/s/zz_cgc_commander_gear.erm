!!re (hero:y)/0/155;
 !!HE(hero):O?(owner:y);
 !!co|(owner)<0/(owner)>7;
 !!FU(CLT_IsHuman):P(hero)/?(human:y);
 !!co&(human)>0;
 !!re (slot:y)/0/5;
  !!SN:W^cgc.v1.gear.%(hero).%(slot)^/0;
 !!en;
