!#VA(hero:x) (kind:x) (collected:x) (n0:x) (n1:x) (n2:x) (n3:x) (n4:x) (n5:x);
!!VR(collected):S0;
!!VR(n0):S0;
!!VR(n1):S0;
!!VR(n2):S0;
!!VR(n3):S0;
!!VR(n4):S0;
!!VR(n5):S0;
!!FU|(hero)<0/(hero)>155/(kind)<0/(kind)>2:E;
!!VR(base:y):S(kind) *6 +531;
!!VR(relic:y):S549 +(kind);
!!re (position:y)/0/88;
 !!if&(position)<83;
  !!FU(GetArtAtSlot):P(hero)/(position)/?(art:y)/?i;
 !!el;
  !!VR(slot:y):S(position) -83;
  !!FU(CGC_Equipped):P(hero)/(slot)/?(art);
 !!en;
 !!VR(part:y):S(art) -(base);
 !!VR(n0)|(part)=0/(art)=(relic):+1;
 !!VR(n1)|(part)=1/(art)=(relic):+1;
 !!VR(n2)|(part)=2/(art)=(relic):+1;
 !!VR(n3)|(part)=3/(art)=(relic):+1;
 !!VR(n4)|(part)=4/(art)=(relic):+1;
 !!VR(n5)|(part)=5/(art)=(relic):+1;
!!en;
!!VR(collected)&(n0)>0:+1;
!!VR(collected)&(n1)>0:+1;
!!VR(collected)&(n2)>0:+1;
!!VR(collected)&(n3)>0:+1;
!!VR(collected)&(n4)>0:+1;
!!VR(collected)&(n5)>0:+1;
