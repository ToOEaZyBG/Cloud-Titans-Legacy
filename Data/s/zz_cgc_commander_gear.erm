!?FU(CGC_Bonuses);
!#VA(hero:x) (attack:x) (defence:x) (damage:x) (health:x) (speed:x) (spell:x) (passive:x) (aura:x);
!!VR(attack):S0;
!!VR(defence):S0;
!!VR(damage):S0;
!!VR(health):S0;
!!VR(speed):S0;
!!VR(spell):S0;
!!VR(passive):S0;
!!VR(aura):S0;
!!FU|(hero)<0/(hero)>155:E;
!!SN:W^cgc.ready^/?(ready:y);
!!FU&(ready)<>1:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!UN:P3/?(disabled:y);
!!FU&(disabled)<>0:E;
!!CO(hero):E?(enabled:y) D?(dead:y);
!!FU|(enabled)<>1/(dead)<>0:E;
!!FU(CGC_State):P(hero)/0/?i/?(c0:y);
!!FU(CGC_State):P(hero)/1/?i/?(c1:y);
!!FU(CGC_State):P(hero)/2/?i/?(c2:y);
!!VR(total:y):S(c0) +(c1) +(c2) *5;
!!re (kind:y)/0/2;
 !!VR(count:y):S(c0);
 !!VR(count)&(kind)=1:S(c1);
 !!VR(count)&(kind)=2:S(c2);
 !!VR(total)&(count)>=2:+5;
 !!VR(total)&(count)>=4:+5;
 !!VR(total)&(count)>=6:+10;
!!en;
!!VR(attack):S(total);
!!VR(defence):S(total);
!!VR(damage):S(total);
!!VR(health):S(total);
!!VR(speed):S(total);
!!VR(spell):S(total);
!!VR(passive):S(total);
!!VR(aura):S(total);
!!VR(attack)&(c0)=6:+40;
!!VR(damage)&(c0)=6:+40;
!!VR(defence)&(c1)=6:+40;
!!VR(health)&(c1)=6:+40;
!!VR(spell)&(c2)=6:+40;
!!VR(passive)&(c2)=6:+40;
