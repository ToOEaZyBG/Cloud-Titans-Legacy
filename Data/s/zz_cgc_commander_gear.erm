!?FU(CGC_State);
!#VA(hero:x) (kind:x) (mask:x) (count:x);
!!VR(mask):S0;
!!VR(count):S0;
!!FU|(hero)<0/(hero)>155/(kind)<0/(kind)>2:E;
!!SN:W^cgc.ready^/?(ready:y);
!!FU&(ready)<>1:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!UN:P3/?(disabled:y);
!!CO(hero):E?(enabled:y) D?(dead:y);
!!FU|(disabled)<>0/(enabled)<>1/(dead)<>0:E;
!!VR(base:y):S(kind) *6 +531;
!!VR(relic:y):S549 +(kind);
!!re (slot:y)/0/5;
 !!FU(CGC_Equipped):P(hero)/(slot)/?(art:y);
 !!VR(expected:y):S(base) +(slot);
 !!VR(bit:y):S1 Sd<<(slot);
 !!SN:W^cgc.native.ready^/?(nativeMode:y);
 !!if&(nativeMode)=1;
  !!VR(part:y):S(art) -(base);
  !!if&(part)>=0/(part)<6;
   !!VR(bit):S1 Sd<<(part);
   !!VR(mask):|(bit);
  !!en;
  !!VR(mask)&(art)=(relic):S63;
 !!el;
  !!VR(mask)&(art)=(expected):|(bit);
  !!VR(mask)&(slot)=5/(art)=(relic):S63;
 !!en;
!!en;
!!re (slot)/0/5;
 !!VR(bit):S(mask) Sd>>(slot) &1;
 !!VR(count):+(bit);
!!en;

