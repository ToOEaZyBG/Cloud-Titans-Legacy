ZVSE2
; Online Lobby experiment: sequential turns only. Apply each operation locally
; before broadcasting. Receivers are idempotent, so an echoed packet is harmless.
; Do not rely on the network transport to execute the sender callback.

!?FU(CLT_IsLocalOwner);
!#VA(owner:x) (local:x);
!!VR(local):S0;
!!FU|(owner)<0/(owner)>7:E;
!!OW:G(owner)/?(local);

!?FU(CLT_RequestForge);
!#VA(hero:x) (town:x);
!!FU&(hero)<0:E;
!!UN:V?i/?i/?i/?(network:y)/?i;
!!if&(network)=0;
 !!FU(CLT_Forge):P(hero)/(town);
 !!FU:E;
!!en;
!!HE(hero):O?(owner:y);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!SN:W^clt.net.forge.seq.%(hero)^/?(sequence:y);
!!VR(sequence):+1;
!!FU26891:P(hero)/(town)/(sequence);
!!IP:D-1;
!!FU26891:D(hero)/(town)/(sequence);

!?FU(CLT_ReceiveForge);
!#VA(hero:x) (town:x) (sequence:x);
!!FU|(hero)<0/(sequence)<=0/(town)<-3/(town)>47:E;
!!SN:W^clt.net.forge.seq.%(hero)^/?(old:y);
!!FU&(sequence)<=(old):E;
!!SN:W^clt.net.forge.seq.%(hero)^/(sequence);
!!FU(CLT_Forge):P(hero)/(town);

!?FU(CLT_QuestProgressSet);
!#VA(owner:x) (quest:x) (value:x);
!!FU:E; ; Dev19 uses guarded shared quest packets.

!!FU|(owner)<0/(owner)>7/(quest)<0/(quest)>7/(value)<0:E;
!!FU(CLT_QuestProgressKey):P(owner)/(quest)/?(key:z);
!!SN:W(key)/?(old:y);
; Absolute, monotonic state: duplicate packets cannot double casualties.
!!SN&(value)>(old):W(key)/(value);

!?FU(CLT_ClaimQuest);
!#VA(hero:x) (town:x) (quest:x);
!!FU:E; ; Dev19 uses guarded shared quest packets.

!!FU|(hero)<0/(hero)>155/(town)<0/(town)>47/(quest)<0/(quest)>7:E;
!!HE(hero):O?(owner:y) E?i/?(level:y);
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!HE(hero):B2/?(heroClass:y);
!!VR(heroTown:y):S(heroClass) :2;
!!FU|(human)=0/(level)<25/(heroTown)<>(TOWN_TOWER):E;
!!CA0/(town):O?(townOwner:y) T?(kind:y) H1/?(visitor:y) H0/?(garrison:y);
!!FU|(owner)<>(townOwner)/(kind)<>(TOWN_TOWER):E;
!!FU&(hero)<>(visitor)/(hero)<>(garrison):E;
!!FU(CLT_QuestTownRequirements):P(town)/?(missing:y);
!!FU&(missing)>0:E;
!!FU(CLT_QuestInfo):P(quest)/?(goal:y)/?(name:z)/?(description:z);
!!FU(CLT_QuestProgressKey):P(owner)/(quest)/?(key:z);
!!SN:W(key)/?(progress:y) W^clt.quest.%(owner).claimed.%(quest)^/?(claimed:y);
!!FU|(claimed)>0/(progress)<(goal):E;
!!VR(artifact:y):S450 +(quest);
!!HE(hero):A2/(artifact)/?(before:y)/?i;
!!HE(hero):A4/(artifact);
!!HE(hero):A2/(artifact)/?(after:y)/?i;
!!SN&(after)>(before):W^clt.quest.%(owner).claimed.%(quest)^/1;

!?FU(CLT_NetWorldSite);
!#VA(index:x) (bx:x) (by:x) (bz:x) (previous:x) (part:x);
!!UN:X?(size:y)/?(underground:y);
!!FU|(index)<1/(index)>140/(bx)<0/(by)<0/(bx)>=(size)/(by)>=(size)/(bz)<0/(bz)>(underground)/(previous)<7/(previous)>128:E;
!!FU(CFS_IsComponent):P(part)/?(valid:y);
!!FU&(valid)=0:E;
!!FU(CFS_WorldPacketReady):P(index)/(bx)/(by)/(bz)/(previous)/(part)/?(packetReady:y);
!!FU&(packetReady)=0:E;
!!SN:W^clt.world.p.%(index).taken^/?(taken:y);
!!FU&(taken)>0:E;
!!OB(bx)/(by)/(bz):T?(kind:y) U?(actual:y);
; Sender has already placed this site. Repeated messages are harmless.
!!SN:W^clt.pickup.site.%(bx).%(by).%(bz)^/?(known:y);
!!if&(kind)=(OBJ_ARTIFACT)/(actual)=(previous)/(known)=(index);
 ; Record the same plan even if native synchronization already placed it.
 !!FU(CFS_MapHint):P(bx)/(by)/(bz)/(part);
!!SN:W^clt.world.p.%(index).x^/(bx) W^clt.world.p.%(index).y^/(by) W^clt.world.p.%(index).z^/(bz) W^clt.world.p.%(index).art^/(part) W^clt.world.p.%(index).old^/(previous) W^clt.pickup.site.%(bx).%(by).%(bz)^/(index);
 !!FU:E;
!!en;
!!if|(kind)<>(OBJ_ARTIFACT)/(actual)<>(previous);
 !!FU(CFS_WorldError):P;
 !!FU:E;
!!en;
!!UN:O(bx)/(by)/(bz)/1/0;
!!UN:I(bx)/(by)/(bz)/(OBJ_ARTIFACT)/(previous)/(OBJ_ARTIFACT)/(part)/-1/0;
!!OB(bx)/(by)/(bz):U(previous) C0;
!!OB(bx)/(by)/(bz):T?(actualType:y) U?(actual);
!!if|(actualType)<>(OBJ_ARTIFACT)/(actual)<>(previous);
 !!UN:O(bx)/(by)/(bz)/1/0;
 !!UN:I(bx)/(by)/(bz)/(OBJ_ARTIFACT)/(previous)/(OBJ_ARTIFACT)/(previous)/-1/0;
 !!OB(bx)/(by)/(bz):C0;
 !!FU(CFS_WorldError):P;
 !!FU:E;
!!en;
!!FU(CFS_MapHint):P(bx)/(by)/(bz)/(part);
!!SN:W^clt.world.p.%(index).x^/(bx) W^clt.world.p.%(index).y^/(by) W^clt.world.p.%(index).z^/(bz) W^clt.world.p.%(index).art^/(part) W^clt.world.p.%(index).old^/(previous) W^clt.pickup.site.%(bx).%(by).%(bz)^/(index);

!?FU(CLT_NetWorldDone);
!#VA(count:x);
!!FU|(count)<0/(count)>140:E;
!!FU(CFS_WorldPlanReady):P(count)/?(planReady:y);
!!if&(planReady)=0;
 !!FU(CFS_WorldError):P;
 !!IF:M^Faction component plan is incomplete or inconsistent. Stop this test and keep both saves/debug folders.^;
 !!FU:E;
!!en;
!!SN:W^clt.net.world.complete^/1 W^clt.world.done^/1 W^clt.world.placed^/(count);
!!VR(hash:y):S0;
!!re (index:y)/1/(count);
 !!SN:W^clt.world.p.%(index).x^/?(bx:y) W^clt.world.p.%(index).y^/?(by:y) W^clt.world.p.%(index).z^/?(bz:y) W^clt.world.p.%(index).art^/?(part:y);
 !!VR(term:y):S(bx) *257;
 !!VR(other:y):S(by) *17;
 !!VR(term):+(other) +(part);
 !!VR(other):S(bz) *450;
 !!VR(term):+(other);
 !!VR(hash):*25173 +(term) %65521;
!!en;
!!SN:W^clt.net.world.hash^/(hash);
!!SN:W^clt.net.world.error^/?(error:y);
!!SN:F^WriteStrToIni^/^hash^/^%(hash)^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^WriteStrToIni^/^placed^/^%(count)^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:W^clt.net.world.layer.0^/?(surface:y) W^clt.net.world.layer.1^/?(lower:y);
!!SN:F^WriteStrToIni^/^surface^/^%(surface)^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^WriteStrToIni^/^underground^/^%(lower)^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^WriteStrToIni^/^world_error^/^%(error)^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^WriteStrToIni^/^version^/^0.6.0-batch-dev21^/^network^/^Debug\CloudTitansNetwork.ini^;
!!SN:F^SaveIni^/^Debug\CloudTitansNetwork.ini^;
!!IF&(error)>0:M^Cloud Titans NETWORK TEST: map placement mismatch. Stop this test and keep both saves/debug folders.^;

; Fixed numeric wire entry points: peers may allocate named functions differently.
; This range is private to this mod and must not be reused by another mod.
!?FU26891;
!!FU(CLT_ReceiveForge):Px1/x2/x3;
!?FU26892;
!!FU(CLT_QuestProgressSet):Px1/x2/x3;
!?FU26893;
!!FU(CLT_ClaimQuest):Px1/x2/x3;
!?FU26894;
!!FU(CLT_NetWorldSite):Px1/x2/x3/x4/x5/x6;
!?FU26895;
!!FU(CLT_NetWorldDone):Px1;
!?FU26896;
!!FU(CLT_NetTestKit):Px1/x2;

!?FU(gem_OnOpenButtonDlg);
!!UN:V?i/?i/?i/?(network:y)/?i;
!!FU&(network)=0:E;
!!CA-1:T?(kind:y) O?(owner:y);
!!FU&(kind)<>(TOWN_TOWER):E;
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!FU(gem_AddTownButton):P^cltquest.def^/64/32/^Cloud Titans network test^/^Network test kit and status^/^Optional test components and network status.^/(CLT_NetTestMenu)/0/0/0;

!?FU(CLT_NetTestMenu);
!!CA-1:U?(town:y) H1/?(hero:y) O?(owner:y);
!!CA-1&(hero)<0:H0/?(hero);
!!FU(CLT_IsLocalOwner):P(owner)/?(local:y);
!!FU&(local)=0:E;
!!FU(RadioDlg_Reset):P;
!!FU(RadioDlg_SetTitle):P^Cloud Titans - NETWORK TEST^;
!!FU(RadioDlg_AddItem):P^Show network status^/0;
!!FU(RadioDlg_AddItem):P^Receive 8 components - test only, once per player^/1;
!!FU(RadioDlg_AddCancelButton):P;
!!FU(RadioDlg_Show):P?(selected:y)/?(action:y)/?(tag:z);
!!FU&(selected)<0:E;
!!if&(action)=0;
 !!SN:W^clt.world.placed^/?(placed:y) W^clt.net.world.hash^/?(hash:y) W^clt.net.world.error^/?(error:y) W^clt.net.quest.error^/?(questError:y);
 !!VR(status:z):S^Build: 0.6.0-batch-dev21
Placed: %(placed). Map hash: %(hash). Errors: %(error).
Quest write errors: %(questError).
Confirmed wins per player (compare on both computers):
^;
 !!re (player:y)/0/7;
  !!SN:W^clt.quest.%(player).progress.0^/?(wins:y);
  !!VR(status):S^%(status)Player %(player): %(wins)
^;
 !!en;
 !!IF:M(status);
 !!FU:E;
!!en;
!!if&(hero)<0;
 !!IF:M^Bring your hero into this Tower first.^;
 !!FU:E;
!!en;
!!IF:Q1^Receive all eight components for a quick network test? This is a test-only gift, once per player. Keep eight free backpack spaces.^;
!!FU&-1:E;
!!FU26896:P(hero)/(town);
!!IP:D-1;
!!FU26896:D(hero)/(town);
!!SN:W^clt.net.kit.%(owner)^/?(given:y);
!!IF&(given)>0:M^Test kit delivered. Equip the eight components and test assembly/disassembly.^;
!!IF&(given)=0:M^No test kit delivered. Check hero ownership, town and eight free backpack spaces.^;

!?FU(CLT_NetTestKit);
!#VA(hero:x) (town:x);
!!FU|(hero)<0/(town)<0/(town)>47:E;
!!FU(CLT_IsHuman):P(hero)/?(human:y);
!!FU&(human)=0:E;
!!HE(hero):O?(owner:y);
!!CA0/(town):O?(townOwner:y) T?(kind:y) H1/?(visitor:y) H0/?(garrison:y);
!!FU|(owner)<>(townOwner)/(kind)<>(TOWN_TOWER):E;
!!FU&(hero)<>(visitor)/(hero)<>(garrison):E;
!!SN:W^clt.net.kit.%(owner)^/?(given:y);
!!FU&(given)>0:E;
!!FU(CLT_BackpackCount):P(hero)/?(used:y);
!!FU&(used)>56:E;
!!re (art:y)/450/457;
 !!HE(hero):A(art);
!!en;
!!SN:W^clt.net.kit.%(owner)^/1;
