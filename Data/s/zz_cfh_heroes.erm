!!OW:I(owner)/?(ai:y);
!!FU&(ai)>0:E;
!!VR(town:y):S(registered) -1;
!!FU(CFH_Bonus):P(town)/(type)/(level)/?(attack:y)/?(defense:y)/?(speed:y);
!!FU&(attack)=0/(defense)=0/(speed)=0:E;
!!UN:C(traits)/84/4/?(a:y) C(traits)/88/4/?(d:y) C(traits)/80/4/?(s:y);
!!FU|(a)<0/(a)>1000000/(d)<0/(d)>1000000/(s)<0/(s)>1000000:E;
!!VR(a):+(attack);
!!VR(d):+(defense);
!!VR(s):+(speed);
!!UN:C(traits)/84/4/(a) C(traits)/88/4/(d) C(traits)/80/4/(s);

