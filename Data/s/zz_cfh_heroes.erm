!#VA(owner:x) (kind:x) (result:x);
!!VR(result):S-1;
!!FU(CFH_Identity):P(kind)/?i/?(wanted:y)/?i;
!!VR(mask:y):S1 Sd<<(owner);
!!re (hero:y)/0/143;
 ; Zero XP does not prove a fresh slot: a dismissed level-one hero can retain
 ; equipment correction ledgers. Never reuse that state as a new champion.
 !!SN:W^cfh.v1.initialized.%(hero)^/?(used:y) W^clt.primary.ready.%(hero)^/?(towerUsed:y) W^cfs.v1.primary.ready.%(hero)^/?(factionUsed:y);
 !!co|(used)>0/(towerUsed)>0/(factionUsed)>0;
 ; Commander equipment is also retained ownership, even at zero hero XP.
 !!VR(gearUsed:y):S0;
 !!re (gearSlot:y)/0/5;
  !!SN:W^cgc.v1.gear.%(hero).%(gearSlot)^/?(gear:y);
  !!VR(gearUsed)&(gear)<>0:S1;
  !!SN:W^cgc.native.ready^/?(nativeGearMode:y);
  !!if&(nativeGearMode)=1;
   !!CO(hero):A3/(gearSlot)/?(nativeGear:y)/?i;
   !!VR(gearUsed)&(nativeGear)<>0:S1;
  !!en;
 !!en;
 !!re (growthKind:y)/0/2;
  !!SN:W^cgc.growth.v1.%(hero).%(growthKind).wins^/?(growthWins:y);
  !!VR(gearUsed)&(growthWins)>0:S1;
 !!en;
 !!co&(gearUsed)>0;
 !!HE(hero):O?(heroOwner:y) P?(x:y)/?(y:y)/?(z:y) B2/?(class:y);
 ; The installed ERA stdlib uses all three negative coordinates to exclude
 ; Prison heroes as well as heroes already placed on the map.
 !!co|(heroOwner)>=0/(x)>=0/(y)>=0/(z)>=0/(class)<>(wanted);
 ; As in shipped WOG_GetRandomUnoccupiedHero, R3's player mask is INPUT.
 ; Querying it as a second output asks the wrong availability question.
 !!HE(hero):E?(experience:y)/?(level:y)/1 R3/?(enabled:y)/(mask);
 ; Native unused heroes have random starting XP below100, not necessarily0.
 !!co|(enabled)=0/(experience)<0/(experience)>99/(level)<0/(level)>1;
 !!CO(hero):X1/?(commanderXp:y) X2/?(commanderLevel:y);
 !!co|(commanderXp)<0/(commanderXp)>99/(commanderLevel)<0/(commanderLevel)>1;
 !!VR(tavern:y):S0;
 !!re (player:y)/0/7;
  !!OW:V(player)/?(left:y)/?(right:y);
  !!VR(tavern)|(left)=(hero)/(right)=(hero):S1;
 !!en;
 !!co&(tavern)>0;
 !!VR(result):S(hero);
 !!FU:E;
!!en;

