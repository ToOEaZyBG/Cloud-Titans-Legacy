!?FU(CGC_MapPart);
!#VA(placed:x) (art:x);
!!VR(copy:y):S(placed) :90;
!!VR(item:y):S(placed) %90 +(copy) %90;
!!FU(CGC_MapArt):P(item)/?(art);
!?FU(CGC_IsMapArtifact);
!#VA(art:x) (valid:x);
!!FU(CFS_IsComponent):P(art)/?(valid);
!!VR(valid)&(art)>=531/(art)<=548:S1;

; Read-only tile checks use shipped TR:P/E/T contracts. Never change terrain,
; remove other objects or create on water/rock, entrances or blocked tiles.
!?FU(CGC_FreeTile);
!#VA(x:x) (y:x) (z:x) (size:x) (okay:x);
!!VR(okay):S0;
!!VR(last:y):S(size) -1;
!!FU|(x)<1/(y)<1/(x)>=(last)/(y)>=(last):E;
!!OB(x)/(y)/(z):T?(kind:y);
!!FU|(kind)<-1/(kind)>0:E;
!!TR(x)/(y)/(z):P?(pass:y) E?(notYellow:y) T?(terrain:y);
!!FU|(pass)<>1/(notYellow)<>1/(terrain)<0/(terrain)>7:E;
!!re (edge:y)/0/3;
 !!VR(nx:y):S(x);
 !!VR(ny:y):S(y);
 !!VR(nx)&(edge)=0:-1;
 !!VR(nx)&(edge)=1:+1;
 !!VR(ny)&(edge)=2:-1;
 !!VR(ny)&(edge)=3:+1;
 !!TR(nx)/(ny)/(z):P?(pass) E?(notYellow);
 !!FU|(pass)<>1/(notYellow)<>1:E;
!!en;
!!VR(okay):S1;

!?FU(CGC_SeedPool);
!#VA(size:x) (underground:x);
!!SN:W^cgc.world.size^/(size);
!!VR(cells:y):S(size) *(size);
!!VR(wanted:y):S540;
!!VR(wanted)&(underground)>0:S270;
!!re (z:y)/0/(underground);
 !!VR(position:y):S(size) *127 +(z) *31 %(cells);
 !!re (scan:y)/1/(cells);
  !!SN:W^cfs.world.pool.layer.%(z)^/?(layerCount:y) W^clt.world.pool^/?(pool:y) W^clt.world.error^/?(error:y);
  !!FU|(pool)>=2048/(error)>0:E;
  !!if&(layerCount)>=(wanted);
   !!br;
  !!en;
  !!VR(position):+104729 %(cells);
  !!VR(x:y):S(position) %(size);
  !!VR(y:y):S(position) :(size);
  !!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(free:y);
  !!co&(free)=0;
  ; Virtual candidate only. Create no temporary native object or extra RNG hook.
  !!VR(pool):+1;
  !!VR(score:y):S(x) +1 *109;
  !!VR(term:y):S(y) +1 *277;
  !!VR(score):+(term);
  !!VR(term):S(z) +1 *1879;
  !!VR(score):+(term) +6488;
  !!VR(term):S(size) *31;
  !!VR(score):+(term) %65521 *25173 +13849 %65521;
  !!SN:W^clt.world.pool^/(pool) W^clt.world.c.%(pool).x^/(x) W^clt.world.c.%(pool).y^/(y) W^clt.world.c.%(pool).z^/(z) W^clt.world.c.%(pool).old^/7 W^clt.world.c.%(pool).score^/(score) W^clt.world.c.%(pool).used^/0 W^clt.world.c.%(pool).seed^/1;
  !!SN:W^cfs.world.pool.layer.%(z)^/d1;
 !!en;
!!en;

!?FU(CGC_FillMap);
!#VA(size:x) (limit:x) (underground:x);
!!VR(start:y):S(size) :12 F1/6;
!!VR(attempts:y):S(start) -1;
!!re (attempt:y)/0/(attempts);
 !!SN:W^clt.world.placed^/?(placed:y) W^clt.world.error^/?(error:y);
 !!FU|(placed)>=(limit)/(error)>0:E;
 !!VR(gap:y):S(start) -(attempt);
 !!VR(needed:y):S(limit) -(placed);
 !!FU(CLT_WorldPlace):P(size)/(needed)/(gap);
!!en;

!?FU(CGC_CleanupSeeds);
; Candidates were virtual: there are no unused native placeholders to remove.
!!FU:E;

!?FU(CGC_CandidateReady);
!#VA(index:x) (x:x) (y:x) (z:x) (old:x) (okay:x);
!!SN:W^clt.world.c.%(index).seed^/?(seed:y);
!!if&(seed)=1;
 !!SN:W^cgc.world.size^/?(size:y);
 !!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(okay);
 !!FU:E;
!!en;
!!VR(okay):S0;
!!OB(x)/(y)/(z):T?(kind:y) U?(actual:y);
!!VR(okay)&(kind)=(OBJ_ARTIFACT)/(actual)=(old):S1;

!?FU(CGC_MapCounts);
!#VA(count:x) (okay:x);
!!VR(okay):S0;
!!FU&(count)<>270:E;
!!re (item:y)/0/89;
 !!FU(CGC_MapArt):P(item)/?(wanted:y);
 !!VR(copies:y):S0;
 !!re (index:y)/1/(count);
  !!SN:W^clt.world.p.%(index).art^/?(art:y);
  !!VR(copies)&(art)=(wanted):+1;
 !!en;
 !!FU&(copies)<>3:E;
!!en;
!!VR(okay):S1;

!?FU(CGC_SeedReceive);
!#VA(index:x) (x:x) (y:x) (z:x) (previous:x) (seed:x) (ready:x);
!!VR(ready):S0;
!!FU|(seed)<0/(seed)>1:E;
!!SN:W^clt.world.p.%(index).art^/?(recorded:y) W^clt.world.p.%(index).seed^/?(saved:y);
!!FU&(recorded)>0/(saved)<>(seed):E;
!!if|(seed)=0/(recorded)>0;
 !!VR(ready):S1;
 !!FU:E;
!!en;
!!FU&(previous)<>7:E;
!!UN:X?(size:y)/?(underground:y);
!!FU|(z)<0/(z)>(underground):E;
!!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(free:y);
!!FU&(free)=0:E;
; The ordinary placement receiver creates the final proxy exactly once.
!!VR(ready):S1;
