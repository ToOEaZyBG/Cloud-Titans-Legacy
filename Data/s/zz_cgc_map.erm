!?FU(CGC_MapPart);
!#VA(placed:x) (art:x);
!!VR(copy:y):S(placed) :78;
!!VR(item:y):S(placed) %78 +(copy) %78;
!!FU(CGC_MapArt):P(item)/?(art);
!?FU(CGC_IsMapArtifact);
!#VA(art:x) (valid:x);
!!FU(CFS_IsComponent):P(art)/?(valid);
!!VR(valid)&(art)>=531/(art)<=536:S1;

; Read-only tile checks use shipped TR:P/E/T contracts. Never change terrain,
; remove other objects or create on water/rock, entrances or blocked tiles.
!?FU(CGC_FreeTile);
!#VA(x:x) (y:x) (z:x) (size:x) (okay:x);
!!VR(okay):S0;
!!VR(last:y):S(size) -1;
!!FU|(x)<1/(y)<1/(x)>=(last)/(y)>=(last):E;
!!OB(x)/(y)/(z):T?(kind:y);
!!FU|(kind)<-1/(kind)>0:E;
!!TR(x)/(y)/(z):P?(pass:y) E?(notYellow:y) T?(terrain:y);
!!FU|(pass)<>1/(notYellow)<>1/(terrain)<0/(terrain)>7:E;
!!VR(access:y):S0;
!!re (edge:y)/0/3;
 !!VR(nx:y):S(x);
 !!VR(ny:y):S(y);
 !!VR(nx)&(edge)=0:-1;
 !!VR(nx)&(edge)=1:+1;
 !!VR(ny)&(edge)=2:-1;
 !!VR(ny)&(edge)=3:+1;
 !!TR(nx)/(ny)/(z):P?(pass) E?(notYellow);
 !!VR(access)&(pass)=1/(notYellow)=1:+1;
!!en;
!!FU&(access)=0:E;
; Retain the original external adventure-map monster protection policy.
; Do not add an embedded AR army or a separate scripted battle.
!!FU(CLT_WorldGuarded):P(x)/(y)/(z)/(size)/?(guarded:y);
!!FU&(guarded)=0:E;
!!VR(okay):S1;

!?FU(CGC_SeedPool);
!#VA(size:x) (underground:x);
!!SN:W^cgc.world.size^/(size);
!!VR(cells:y):S(size) *(size);
!!VR(wanted:y):S312;
!!VR(wanted)&(underground)>0:S156;
!!re (z:y)/0/(underground);
 !!VR(position:y):S(size) *127 +(z) *31 %(cells);
 !!re (scan:y)/1/(cells);
  !!SN:W^cfs.world.pool.layer.%(z)^/?(layerCount:y) W^clt.world.pool^/?(pool:y) W^clt.world.error^/?(error:y);
  !!FU|(pool)>=2048/(error)>0:E;
  !!if&(layerCount)>=(wanted);
   !!br;
  !!en;
  !!VR(position):+104729 %(cells);
  !!VR(x:y):S(position) %(size);
  !!VR(y:y):S(position) :(size);
  !!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(free:y);
  !!co&(free)=0;
  ; Virtual candidate only. Create no temporary native object or extra RNG hook.
  !!VR(pool):+1;
  !!VR(score:y):S(x) +1 *109;
  !!VR(term:y):S(y) +1 *277;
  !!VR(score):+(term);
  !!VR(term):S(z) +1 *1879;
  !!VR(score):+(term) +6488;
  !!VR(term):S(size) *31;
  !!VR(score):+(term) %65521 *25173 +13849 %65521;
  !!SN:W^clt.world.pool^/(pool) W^clt.world.c.%(pool).x^/(x) W^clt.world.c.%(pool).y^/(y) W^clt.world.c.%(pool).z^/(z) W^clt.world.c.%(pool).old^/7 W^clt.world.c.%(pool).score^/(score) W^clt.world.c.%(pool).used^/0 W^clt.world.c.%(pool).seed^/1;
  !!SN:W^cfs.world.pool.layer.%(z)^/d1;
 !!en;
!!en;

!?FU(CGC_FillMap);
!#VA(size:x) (limit:x) (underground:x);
!!VR(start:y):S(size) :12 F1/6;
!!VR(attempts:y):S(start) -1;
!!re (attempt:y)/0/(attempts);
 !!SN:W^clt.world.placed^/?(placed:y) W^clt.world.error^/?(error:y);
 !!FU|(placed)>=(limit)/(error)>0:E;
 !!VR(gap:y):S(start) -(attempt);
 !!VR(needed:y):S(limit) -(placed);
 !!FU(CLT_WorldPlace):P(size)/(needed)/(gap);
!!en;

!?FU(CGC_CleanupSeeds);
; Candidates were virtual: there are no unused native placeholders to remove.
!!FU:E;

!?FU(CGC_CandidateReady);
!#VA(index:x) (x:x) (y:x) (z:x) (old:x) (okay:x);
!!SN:W^clt.world.c.%(index).seed^/?(seed:y);
!!if&(seed)=1;
 !!SN:W^cgc.world.size^/?(size:y);
 !!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(okay);
 !!FU:E;
!!en;
!!VR(okay):S0;
!!OB(x)/(y)/(z):T?(kind:y) U?(actual:y);
!!UN:X?(size)/?i;
!!FU(CLT_WorldGuarded):P(x)/(y)/(z)/(size)/?(guarded:y);
!!FU&(guarded)=0:E;
!!VR(okay)&(kind)=(OBJ_ARTIFACT)/(actual)=(old):S1;

!?FU(CGC_MapCounts);
!#VA(count:x) (okay:x);
!!VR(okay):S0;
!!FU&(count)<>156:E;
!!re (item:y)/0/77;
 !!FU(CGC_MapArt):P(item)/?(wanted:y);
 !!VR(copies:y):S0;
 !!re (index:y)/1/(count);
  !!SN:W^clt.world.p.%(index).art^/?(art:y);
  !!VR(copies)&(art)=(wanted):+1;
 !!en;
 !!FU&(copies)<>2:E;
!!en;
!!VR(okay):S1;

!?FU(CGC_SeedReceive);
!#VA(index:x) (x:x) (y:x) (z:x) (previous:x) (seed:x) (ready:x);
!!VR(ready):S0;
!!FU|(seed)<0/(seed)>1:E;
!!SN:W^clt.world.p.%(index).art^/?(recorded:y) W^clt.world.p.%(index).seed^/?(saved:y);
!!FU&(recorded)>0/(saved)<>(seed):E;
!!if|(seed)=0/(recorded)>0;
 !!VR(ready):S1;
 !!FU:E;
!!en;
!!FU&(previous)<>7:E;
!!UN:X?(size:y)/?(underground:y);
!!FU|(z)<0/(z)>(underground):E;
!!FU(CGC_FreeTile):P(x)/(y)/(z)/(size)/?(free:y);
!!FU&(free)=0:E;
; The ordinary placement receiver creates the final proxy exactly once.
!!VR(ready):S1;
; Living Skull reads actual identities without exposing native proxies as loot.
!?FU(CGC_SkullSiteArt);
!#VA(bx:x) (by:x) (bz:x) (art:x);
!!VR(art):S-1;
!!SN:W^clt.pickup.site.%(bx).%(by).%(bz)^/?(index:y);
!!FU|(index)<1/(index)>156:E;
!!SN:W^clt.world.p.%(index).taken^/?(taken:y) W^clt.world.p.%(index).art^/?(part:y) W^clt.world.p.%(index).old^/?(old:y);
!!FU&(taken)<>0:E;
!!SN:W^clt.world.p.%(index).x^/?(px:y) W^clt.world.p.%(index).y^/?(py:y) W^clt.world.p.%(index).z^/?(pz:y);
!!FU|(px)<>(bx)/(py)<>(by)/(pz)<>(bz):E;
!!FU(CGC_IsMapArtifact):P(part)/?(valid:y);
!!FU&(valid)=0:E;
!!OB(bx)/(by)/(bz):T?(kind:y) U?(actual:y);
!!FU&(kind)<>(OBJ_ARTIFACT):E;
!!FU&(actual)<>(old)/(actual)<>(part):E;
!!VR(art):S(part);

!?FU(CGC_SkullExactName);
!#VA(art:x);
!!VR(art):S-1;
!!re (index:y)/0/77;
 !!FU(CGC_MapArt):P(index)/?(part:y);
 !!SN:H^art^/(part)/0/?(name:z);
 !!co&z1<>(name);
 !!VRz23:S(name);
 !!VR(art):S(part);
 !!br;
!!en;

!?FU(CGC_SkullFind);
!#VA(art:x) (found:x);
!!VR(found):S0;
!!FU(CGC_IsMapArtifact):P(art)/?(custom:y);
!!if&(custom)=1;
 !!SN:W^clt.world.placed^/?(count:y);
 !!FU|(count)<1/(count)>156:E;
 !!re (index:y)/1/(count);
  !!SN:W^clt.world.p.%(index).art^/?(part:y);
  !!co&(part)<>(art);
  !!SN:W^clt.world.p.%(index).x^/?(bx:y) W^clt.world.p.%(index).y^/?(by:y) W^clt.world.p.%(index).z^/?(bz:y);
  !!FU(CGC_SkullSiteArt):P(bx)/(by)/(bz)/?(actual:y);
  !!co&(actual)<>(art);
  !!VRv31:S(bx);
  !!VRv32:S(by);
  !!VRv33:S(bz);
  !!VR(found):S1;
  !!br;
 !!en;
!!el;
 !!UN:U(OBJ_ARTIFACT)/(art)/?(count);
 !!FU&(count)<1:E;
 !!re (index)/1/(count);
  !!UN:U(OBJ_ARTIFACT)/(art)/(index)/31;
  !!FU(CGC_SkullSiteArt):Pv31/v32/v33/?(actual);
  !!co&(actual)>=0;
  !!VR(found):S1;
  !!br;
 !!en;
!!en;
